    l3_g_error=l3_gui_loader.l3_status<0 ? l3_gui_loader.l3_status : (l3_restore_failed && l3_g_token<=0 ? l3_restore_loader.l3_status : 0);
    l3_g_error==-1 ? #l3_status="Cannot open WAV. Drop the file again to relink." :
    l3_g_error==-2 ? #l3_status="Unsupported format. Use a mono or stereo WAV." :
    l3_g_error==-3 ? #l3_status="Empty, malformed or oversized WAV. Maximum decoded size: 96 MiB per layer." :
    l3_g_error==-4 ? #l3_status="Buffers busy. Let tails finish or press Panic, then retry." :
    l3_g_error==-5 ? #l3_status="Read failed or invalid audio. Previous applied bank preserved." :
    l3_g_error==-6 ? #l3_status="Load or preview discarded." :
    l3_g_error==-7 ? #l3_status="Source properties changed. Drop WAV to accept replacement." :
    l3_g_error==-8 ? #l3_status="Invalid saved regions. Drop WAV to recover." :
    l3_g_error==-9 ? #l3_status="Insufficient JSFX memory. This build requires about 770 MiB." :
    l3_g_overflow ? #l3_status="More than 256 regions. Increase quiet gap or minimum duration." :
    l3_edit_active ? #l3_status="Editing draft. MIDI plays the applied regions until Apply edits." :
    l3_g_preview ? #l3_status="Detection preview ready. Apply to use these boundaries." :
    l3_gui_loader.l3_status==2 && l3_g_token!=l3_gui_loader.l3_request*4+l3_gui_loader.l3_bank+1 ? #l3_status="Prepared: waiting for audio to adopt the new bank." :
    l3_g_dirty && l3_g_token>0 ? #l3_status="Detection settings changed. Reanalyse to preview new boundaries." :
    strlen(#l3_ui_message)>0 ? strcpy(#l3_status,#l3_ui_message) : #l3_status="Click a region tile to audition. MIDI uses the chosen selection mode.";
  );
  atomic_get(l3_snapshot_retry_exhausted) ? #l3_status="State snapshot was busy. Save again after loading finishes.";
  master_text(24,654,1052,#l3_status,12,l3_g_error<0 || l3_g_preview || l3_edit_active ? 2 : 3);
);
