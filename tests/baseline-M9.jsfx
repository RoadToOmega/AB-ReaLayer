function l4_status_line() (
  l4_gui_loader.l4_status==1 ? sprintf(#l4_status,"Loading WAV: %.0f%%",100*l4_gui_loader.l4_read_items/max(1,l4_gui_loader.l4_items)) :
  l4_gui_loader.l4_status==3 ? sprintf(#l4_status,"Analysing: %.0f%%",100*l4_gui_loader.l4_scan/max(1,l4_gui_loader.l4_meta[1])) : (
    l4_g_error=l4_gui_loader.l4_status<0 ? l4_gui_loader.l4_status : (l4_restore_failed && l4_g_token<=0 ? l4_restore_loader.l4_status : 0);
    l4_g_error==-1 ? #l4_status="Cannot open WAV. Drop the file again to relink." :
    l4_g_error==-2 ? #l4_status="Unsupported format. Use a mono or stereo WAV." :
    l4_g_error==-3 ? #l4_status="Empty, malformed or oversized WAV. Maximum decoded size: 96 MiB per layer." :
    l4_g_error==-4 ? #l4_status="Buffers busy. Let tails finish or press Panic, then retry." :
    l4_g_error==-5 ? #l4_status="Read failed or invalid audio. Previous applied bank preserved." :
    l4_g_error==-6 ? #l4_status="Load or preview discarded." :
    l4_g_error==-7 ? #l4_status="Source properties changed. Drop WAV to accept replacement." :
    l4_g_error==-8 ? #l4_status="Invalid saved regions. Drop WAV to recover." :
    l4_g_error==-9 ? #l4_status="Insufficient JSFX memory. This build requires about 770 MiB." :
    l4_g_overflow ? #l4_status="More than 256 regions. Increase quiet gap or minimum duration." :
    l4_edit_active ? #l4_status="Editing draft. MIDI plays the applied regions until Apply edits." :
    l4_g_preview ? #l4_status="Detection preview ready. Apply to use these boundaries." :
    l4_gui_loader.l4_status==2 && l4_g_token!=l4_gui_loader.l4_request*4+l4_gui_loader.l4_bank+1 ? #l4_status="Prepared: waiting for audio to adopt the new bank." :
    l4_g_dirty && l4_g_token>0 ? #l4_status="Detection settings changed. Reanalyse to preview new boundaries." :
    strlen(#l4_ui_message)>0 ? strcpy(#l4_status,#l4_ui_message) : #l4_status="Click a region tile to audition. MIDI uses the chosen selection mode.";
  );
  atomic_get(l4_snapshot_retry_exhausted) ? #l4_status="State snapshot was busy. Save again after loading finishes.";
  master_text(24,654,1052,#l4_status,12,l4_g_error<0 || l4_g_preview || l4_edit_active ? 2 : 3);
);
