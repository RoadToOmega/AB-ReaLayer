function l4_snapshot() (
// Snapshot the active immutable table. Voices hold copies of start/end bounds.
l4_g_token=l4_gui_reader.l4_pin_active();
l4_g_token>0 ? (
  l4_g_meta=l4_bank_meta+l4_token_bank(l4_g_token)*l4_bank_stride;
  strcpy(#l4_display_path,l4_bank_paths[l4_token_bank(l4_g_token)]);
  l4_g_frames=l4_g_meta[1]; l4_g_channels=l4_g_meta[2]; l4_g_rate=l4_g_meta[3];
  l4_g_count=l4_g_meta[7]; l4_g_overflow=l4_g_meta[8];
  memcpy(75703080,l4_g_meta+32,512);
  memcpy(75704080,l4_region_base+l4_token_bank(l4_g_token)*l4_region_stride,l4_g_count*2);
  memcpy(75704780,l4_g_meta+10,6); memcpy(75705080,l4_region_base+l4_token_bank(l4_g_token)*l4_region_stride+512,l4_g_count);
  l4_gui_reader.l4_unpin(l4_g_token);
  l4_g_last_token!=l4_g_token ? (
    l4_g_last_token=l4_g_token; #l4_ui_message=""; sliderchange(-1);
  );
) : l4_g_token==-1 ? (
  #l4_display_path="No WAV loaded"; l4_g_frames=0; l4_g_count=0; l4_g_overflow=0;
);
// A reanalysis preview remains WRITING and belongs exclusively to this GUI.
// It is never an audio source until Apply publishes it. MIDI uses active data.
l4_g_preview=l4_gui_loader.l4_status==4 && l4_gui_loader.l4_mode==1;
l4_g_active_count=l4_g_count;
l4_g_preview ? (
  l4_g_meta=l4_gui_loader.l4_meta; l4_g_count=l4_g_meta[7]; l4_g_overflow=l4_g_meta[8];
  memcpy(75703080,l4_g_meta+32,512);
  memcpy(75704080,l4_region_base+l4_gui_loader.l4_bank*l4_region_stride,l4_g_count*2);
  memcpy(75704780,l4_g_meta+10,6); memcpy(75705080,l4_region_base+l4_gui_loader.l4_bank*l4_region_stride+512,l4_g_count);
);
l4_g_selected=max(0,min(l4_g_count-1,floor(slider51)-1));
l4_g_dirty=abs(l4_detect7-75704780[0])>.001 || abs(l4_detect8-75704780[1])>.001 ||
        abs(l4_detect9-75704780[2])>.001 || abs(l4_detect10-75704780[3])>.001 ||
        abs(l4_detect11-75704780[4])>.001 || abs(l4_detect12-75704780[5])>.001;


);
function l4_edit_zoom(l4_factor) local(l4_mid,l4_span) (
  l4_mid=(l4_edit_view_start+l4_edit_view_end)/2;l4_span=max(16,min(l4_edit_frames,(l4_edit_view_end-l4_edit_view_start)*l4_factor));
  l4_edit_view_start=max(0,min(l4_edit_frames-l4_span,floor(l4_mid-l4_span/2)));l4_edit_view_end=l4_edit_view_start+l4_span;
);
function l4_edit_pan(l4_direction) local(l4_span) (
  l4_span=l4_edit_view_end-l4_edit_view_start;l4_edit_view_start=max(0,min(l4_edit_frames-l4_span,floor(l4_edit_view_start+l4_direction*l4_span*.5)));l4_edit_view_end=l4_edit_view_start+l4_span;
);
function l4_choose_region(l4_index,l4_audition) (
  slider51=max(1,l4_index+1); slider_automate(slider51,1);
  l4_audition ? atomic_set(l4_preview_request,1);
);
function l4_card() local(l4_x,l4_i,l4_c) (
