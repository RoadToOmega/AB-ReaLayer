    l2_g_error==-1 ? #l2_status="Cannot open WAV. Drop the file again to relink." :
    l2_g_error==-2 ? #l2_status="Unsupported format. Use a mono or stereo WAV." :
    l2_g_error==-3 ? #l2_status="Empty, malformed or oversized WAV. Maximum decoded size: 96 MiB per layer." :
    l2_g_error==-4 ? #l2_status="Buffers busy. Let tails finish or press Panic, then retry." :
    l2_g_error==-5 ? #l2_status="Read failed or invalid audio. Previous applied bank preserved." :
    l2_g_error==-6 ? #l2_status="Load or preview discarded." :
