function l3_snapshot() (
// Snapshot the active immutable table. Voices hold copies of start/end bounds.
l3_g_token=l3_gui_reader.l3_pin_active();
l3_g_token>0 ? (
  l3_g_meta=l3_bank_meta+l3_token_bank(l3_g_token)*l3_bank_stride;
  strcpy(#l3_display_path,l3_bank_paths[l3_token_bank(l3_g_token)]);
  l3_g_frames=l3_g_meta[1]; l3_g_channels=l3_g_meta[2]; l3_g_rate=l3_g_meta[3];
  l3_g_count=l3_g_meta[7]; l3_g_overflow=l3_g_meta[8];
  memcpy(50471720,l3_g_meta+32,512);
  memcpy(50472720,l3_region_base+l3_token_bank(l3_g_token)*l3_region_stride,l3_g_count*2);
  memcpy(50473420,l3_g_meta+10,6); memcpy(50473720,l3_region_base+l3_token_bank(l3_g_token)*l3_region_stride+512,l3_g_count);
  l3_gui_reader.l3_unpin(l3_g_token);
  l3_g_last_token!=l3_g_token ? (
    l3_g_last_token=l3_g_token; #l3_ui_message=""; sliderchange(-1);
  );
) : l3_g_token==-1 ? (
  #l3_display_path="No WAV loaded"; l3_g_frames=0; l3_g_count=0; l3_g_overflow=0;
);
// A reanalysis preview remains WRITING and belongs exclusively to this GUI.
// It is never an audio source until Apply publishes it. MIDI uses active data.
l3_g_preview=l3_gui_loader.l3_status==4 && l3_gui_loader.l3_mode==1;
l3_g_active_count=l3_g_count;
l3_g_preview ? (
  l3_g_meta=l3_gui_loader.l3_meta; l3_g_count=l3_g_meta[7]; l3_g_overflow=l3_g_meta[8];
  memcpy(50471720,l3_g_meta+32,512);
  memcpy(50472720,l3_region_base+l3_gui_loader.l3_bank*l3_region_stride,l3_g_count*2);
  memcpy(50473420,l3_g_meta+10,6); memcpy(50473720,l3_region_base+l3_gui_loader.l3_bank*l3_region_stride+512,l3_g_count);
);
l3_g_selected=max(0,min(l3_g_count-1,floor(slider39)-1));
l3_g_dirty=abs(l3_detect7-50473420[0])>.001 || abs(l3_detect8-50473420[1])>.001 ||
        abs(l3_detect9-50473420[2])>.001 || abs(l3_detect10-50473420[3])>.001 ||
        abs(l3_detect11-50473420[4])>.001 || abs(l3_detect12-50473420[5])>.001;


);
function l3_edit_zoom(l3_factor) local(l3_mid,l3_span) (
  l3_mid=(l3_edit_view_start+l3_edit_view_end)/2;l3_span=max(16,min(l3_edit_frames,(l3_edit_view_end-l3_edit_view_start)*l3_factor));
  l3_edit_view_start=max(0,min(l3_edit_frames-l3_span,floor(l3_mid-l3_span/2)));l3_edit_view_end=l3_edit_view_start+l3_span;
);
function l3_edit_pan(l3_direction) local(l3_span) (
  l3_span=l3_edit_view_end-l3_edit_view_start;l3_edit_view_start=max(0,min(l3_edit_frames-l3_span,floor(l3_edit_view_start+l3_direction*l3_span*.5)));l3_edit_view_end=l3_edit_view_start+l3_span;
);
function l3_choose_region(l3_index,l3_audition) (
  slider39=max(1,l3_index+1); slider_automate(slider39,1);
  l3_audition ? atomic_set(l3_preview_request,1);
);
function l3_card() local(l3_x,l3_i,l3_c) (
  l3_x=20+2*267;
  master_rect(l3_x,92,259,142,.095,.12,.15);
  master_selected==2 ? master_rect(l3_x,92,259,3,.38,.83,.76);
