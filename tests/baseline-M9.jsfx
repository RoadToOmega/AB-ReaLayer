// All drawing and input share logical coordinates; no offscreen size limit.
function master_rect(x,y,w,h,r,g,b) (
  gfx_set(r,g,b,1); gfx_rect(master_ox+x*master_scale,master_oy+y*master_scale,w*master_scale,h*master_scale);
);
function master_line(x,y,x2,y2,r,g,b) (
  gfx_set(r,g,b,1); gfx_line(master_ox+x*master_scale,master_oy+y*master_scale,master_ox+x2*master_scale,master_oy+y2*master_scale);
);
function master_text(x,y,w,label,size,tone) (
  gfx_setfont(1,"Arial",max(9,size*master_scale));
  tone==2 ? gfx_set(.95,.72,.35) : tone==1 ? gfx_set(.38,.83,.76) : tone==3 ? gfx_set(.52,.58,.64) : gfx_set(.89,.92,.94);
  gfx_x=master_ox+x*master_scale; gfx_y=master_oy+y*master_scale;
  gfx_drawstr(label,0,master_ox+(x+w)*master_scale,master_oy+(y+size+7)*master_scale);
);
function master_hit(x,y,w,h) (master_mx>=x && master_mx<x+w && master_my>=y && master_my<y+h;);
function master_button(x,y,w,label,enabled,selected) local(h) (
  h=master_hit(x,y,w,28) && !master_modal;
  master_rect(x,y,w,28,selected ? .16 : h && enabled ? .22 : .13,selected ? .32 : h && enabled ? .26 : .16,selected ? .31 : h && enabled ? .3 : .2);
  selected ? master_rect(x,y+26,w,2,.38,.83,.76);
  master_text(x+8,y+6,w-16,label,12,enabled ? selected : 3);
  enabled && h && master_click;
);
function master_format(p,v) (
  master_spec(p);
  !strcmp(#master_unit,"pan") ? sprintf(#master_value,"%.0f %%",v*100) :
  master_step>=1 ? sprintf(#master_value,"%.0f %s",v,#master_unit) :
  master_step>=.1 ? sprintf(#master_value,"%.1f %s",v,#master_unit) : sprintf(#master_value,"%.2f %s",v,#master_unit);
);
function master_control(x,y,w,label,p,knob) local(v,n,a,cx,cy,r,hover,now) (
  v=master_get(p); master_spec(p);
  n=(v-master_lo)/(master_hi-master_lo); p>=55 && p<=62 ? n=sqrt(n);
  hover=master_hit(x,y,w,knob ? 108 : 44) && !master_modal;
  master_text(x,y,w,label,12,3);
  knob ? (
    cx=master_ox+(x+w/2)*master_scale; cy=master_oy+(y+49)*master_scale; r=23*master_scale;
    gfx_set(.055,.07,.09); gfx_circle(cx,cy,r+4*master_scale,1,1);
    gfx_set(hover || master_drag==p ? .2 : .13,.19,.23); gfx_circle(cx,cy,r,1,1);
    a=-2.35619449+n*4.71238898;
    gfx_set(.28,.38,.42); gfx_arc(cx,cy,r+3*master_scale,-2.35619449,2.35619449,1);
    gfx_set(.38,.83,.76); gfx_arc(cx,cy,r+3*master_scale,-2.35619449,a,1);
    // gfx_arc uses angle zero at the top; match its orientation.
    gfx_line(cx+sin(a)*r*.55,cy-cos(a)*r*.55,cx+sin(a)*r*.88,cy-cos(a)*r*.88);
    master_format(p,v); master_text(x+4,y+82,w-8,#master_value,13,0);
  ) : (
    master_rect(x,y+19,w-6,25,hover ? .2 : .1,.15,.19);
    master_format(p,v); master_text(x+6,y+23,w-16,#master_value,12,0);
    master_rect(x,y+42,(w-6)*max(0,min(1,n)),2,.23,.48,.47);
  );
  hover ? (
    sprintf(#master_hint,"%s: drag up/down | Shift: fine | double-click: reset | right-click: type value",label);
    master_click ? (
      now=time_precise();
      master_last_control==p && now-master_last_click<.32 ? (
        master_put(p,master_default,1); master_last_control=0;
      ) : (
        master_drag=p; master_drag_y=master_my; master_drag_norm=n;
        master_drag_last_y=master_my; master_last_control=p; master_last_click=now;
      );
    );
    master_right_click ? (
      master_focus=p; sprintf(#master_input,"%.4f",v); master_input_fresh=1;
      strcpy(#master_input_label,label); #master_input_error="";
    );
  );
);
function master_finish() (
  master_drag>0 && master_drag<100 ? master_notify(master_drag,1);
  master_drag=0;
);
function master_numeric_commit() local(v,ok,i,c,digits,dots,signs) (
  ok=1;digits=0;dots=0;signs=0;i=0;
  loop(strlen(#master_input),c=str_getchar(#master_input,i);
    c>=48 && c<=57 ? digits+=1 : c==46 ? dots+=1 : (c==45 || c==43) && i==0 ? signs+=1 : ok=0; i+=1;
  );
  ok && digits>0 && dots<=1 && signs<=1 && match("%f",#master_input,v) ? (
    master_put(master_focus,v,1); master_focus=0;
  ) : #master_input_error="Enter a number, using a decimal point if needed.";
);

function l1_snapshot() (
// Snapshot the active immutable table. Voices hold copies of start/end bounds.
l1_g_token=l1_gui_reader.l1_pin_active();
l1_g_token>0 ? (
  l1_g_meta=l1_bank_meta+l1_token_bank(l1_g_token)*l1_bank_stride;
  strcpy(#l1_display_path,l1_bank_paths[l1_token_bank(l1_g_token)]);
  l1_g_frames=l1_g_meta[1]; l1_g_channels=l1_g_meta[2]; l1_g_rate=l1_g_meta[3];
  l1_g_count=l1_g_meta[7]; l1_g_overflow=l1_g_meta[8];
  memcpy(9000,l1_g_meta+32,512);
  memcpy(10000,l1_region_base+l1_token_bank(l1_g_token)*l1_region_stride,l1_g_count*2);
  memcpy(10700,l1_g_meta+10,6); memcpy(11000,l1_region_base+l1_token_bank(l1_g_token)*l1_region_stride+512,l1_g_count);
  l1_gui_reader.l1_unpin(l1_g_token);
  l1_g_last_token!=l1_g_token ? (
    l1_g_last_token=l1_g_token; #l1_ui_message=""; sliderchange(-1);
  );
) : l1_g_token==-1 ? (
  #l1_display_path="No WAV loaded"; l1_g_frames=0; l1_g_count=0; l1_g_overflow=0;
);
// A reanalysis preview remains WRITING and belongs exclusively to this GUI.
// It is never an audio source until Apply publishes it. MIDI uses active data.
l1_g_preview=l1_gui_loader.l1_status==4 && l1_gui_loader.l1_mode==1;
l1_g_active_count=l1_g_count;
l1_g_preview ? (
  l1_g_meta=l1_gui_loader.l1_meta; l1_g_count=l1_g_meta[7]; l1_g_overflow=l1_g_meta[8];
  memcpy(9000,l1_g_meta+32,512);
  memcpy(10000,l1_region_base+l1_gui_loader.l1_bank*l1_region_stride,l1_g_count*2);
  memcpy(10700,l1_g_meta+10,6); memcpy(11000,l1_region_base+l1_gui_loader.l1_bank*l1_region_stride+512,l1_g_count);
);
l1_g_selected=max(0,min(l1_g_count-1,floor(slider15)-1));
l1_g_dirty=abs(l1_detect7-10700[0])>.001 || abs(l1_detect8-10700[1])>.001 ||
        abs(l1_detect9-10700[2])>.001 || abs(l1_detect10-10700[3])>.001 ||
        abs(l1_detect11-10700[4])>.001 || abs(l1_detect12-10700[5])>.001;


);
function l1_edit_zoom(l1_factor) local(l1_mid,l1_span) (
  l1_mid=(l1_edit_view_start+l1_edit_view_end)/2;l1_span=max(16,min(l1_edit_frames,(l1_edit_view_end-l1_edit_view_start)*l1_factor));
  l1_edit_view_start=max(0,min(l1_edit_frames-l1_span,floor(l1_mid-l1_span/2)));l1_edit_view_end=l1_edit_view_start+l1_span;
);
function l1_edit_pan(l1_direction) local(l1_span) (
  l1_span=l1_edit_view_end-l1_edit_view_start;l1_edit_view_start=max(0,min(l1_edit_frames-l1_span,floor(l1_edit_view_start+l1_direction*l1_span*.5)));l1_edit_view_end=l1_edit_view_start+l1_span;
);
function l1_choose_region(l1_index,l1_audition) (
  slider15=max(1,l1_index+1); slider_automate(slider15,1);
  l1_audition ? atomic_set(l1_preview_request,1);
);
function l1_card() local(l1_x,l1_i,l1_c) (
  l1_x=20+0*267;
  master_rect(l1_x,92,259,142,.095,.12,.15);
  master_selected==0 ? master_rect(l1_x,92,259,3,.38,.83,.76);
  sprintf(#l1_card_title,"0%d   LAYER %d",1,1);
  master_text(l1_x+12,104,150,#l1_card_title,13,master_selected==0);
  l1_gui_loader.l1_status==1 ? sprintf(#l1_card_status,"LOAD %.0f%%",100*l1_gui_loader.l1_read_items/max(1,l1_gui_loader.l1_items)) :
  l1_gui_loader.l1_status==3 ? #l1_card_status="DETECTING" :
  l1_gui_loader.l1_status==4 ? #l1_card_status="PREVIEW" :
  (l1_gui_loader.l1_status<0 && l1_gui_loader.l1_status!=-6) || l1_restore_failed ? #l1_card_status="LOAD ERROR" :
  l1_g_token>0 ? #l1_card_status="READY" : #l1_card_status="EMPTY";
  master_text(l1_x+164,106,85,#l1_card_status,10,l1_gui_loader.l1_status==4 || l1_gui_loader.l1_status<0 || l1_restore_failed ? 2 : 3);

  master_click && !master_modal && master_hit(l1_x,92,259,51) ? master_selected=0;
