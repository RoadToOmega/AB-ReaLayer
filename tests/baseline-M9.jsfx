function l1_status_line() (
  l1_gui_loader.l1_status==1 ? sprintf(#l1_status,"Loading WAV: %.0f%%",100*l1_gui_loader.l1_read_items/max(1,l1_gui_loader.l1_items)) :
  l1_gui_loader.l1_status==3 ? sprintf(#l1_status,"Analysing: %.0f%%",100*l1_gui_loader.l1_scan/max(1,l1_gui_loader.l1_meta[1])) : (
    l1_g_error=l1_gui_loader.l1_status<0 ? l1_gui_loader.l1_status : (l1_restore_failed && l1_g_token<=0 ? l1_restore_loader.l1_status : 0);
    l1_g_error==-1 ? #l1_status="Cannot open WAV. Drop the file again to relink." :
    l1_g_error==-2 ? #l1_status="Unsupported format. Use a mono or stereo WAV." :
    l1_g_error==-3 ? #l1_status="Empty, malformed or oversized WAV. Maximum decoded size: 96 MiB per layer." :
    l1_g_error==-4 ? #l1_status="Buffers busy. Let tails finish or press Panic, then retry." :
    l1_g_error==-5 ? #l1_status="Read failed or invalid audio. Previous applied bank preserved." :
    l1_g_error==-6 ? #l1_status="Load or preview discarded." :
    l1_g_error==-7 ? #l1_status="Source properties changed. Drop WAV to accept replacement." :
    l1_g_error==-8 ? #l1_status="Invalid saved regions. Drop WAV to recover." :
    l1_g_error==-9 ? #l1_status="Insufficient JSFX memory. This build requires about 770 MiB." :
    l1_g_overflow ? #l1_status="More than 256 regions. Increase quiet gap or minimum duration." :
    l1_edit_active ? #l1_status="Editing draft. MIDI plays the applied regions until Apply edits." :
    l1_g_preview ? #l1_status="Detection preview ready. Apply to use these boundaries." :
    l1_gui_loader.l1_status==2 && l1_g_token!=l1_gui_loader.l1_request*4+l1_gui_loader.l1_bank+1 ? #l1_status="Prepared: waiting for audio to adopt the new bank." :
    l1_g_dirty && l1_g_token>0 ? #l1_status="Detection settings changed. Reanalyse to preview new boundaries." :
    strlen(#l1_ui_message)>0 ? strcpy(#l1_status,#l1_ui_message) : #l1_status="Click a region tile to audition. MIDI uses the chosen selection mode.";
  );
  atomic_get(l1_snapshot_retry_exhausted) ? #l1_status="State snapshot was busy. Save again after loading finishes.";
  master_text(24,654,1052,#l1_status,12,l1_g_error<0 || l1_g_preview || l1_edit_active ? 2 : 3);
);
