function l2_snapshot() (
// Snapshot the active immutable table. Voices hold copies of start/end bounds.
l2_g_token=l2_gui_reader.l2_pin_active();
l2_g_token>0 ? (
  l2_g_meta=l2_bank_meta+l2_token_bank(l2_g_token)*l2_bank_stride;
  strcpy(#l2_display_path,l2_bank_paths[l2_token_bank(l2_g_token)]);
  l2_g_frames=l2_g_meta[1]; l2_g_channels=l2_g_meta[2]; l2_g_rate=l2_g_meta[3];
  l2_g_count=l2_g_meta[7]; l2_g_overflow=l2_g_meta[8];
  memcpy(25240360,l2_g_meta+32,512);
  memcpy(25241360,l2_region_base+l2_token_bank(l2_g_token)*l2_region_stride,l2_g_count*2);
  memcpy(25242060,l2_g_meta+10,6); memcpy(25242360,l2_region_base+l2_token_bank(l2_g_token)*l2_region_stride+512,l2_g_count);
  l2_gui_reader.l2_unpin(l2_g_token);
  l2_g_last_token!=l2_g_token ? (
    l2_g_last_token=l2_g_token; #l2_ui_message=""; sliderchange(-1);
  );
) : l2_g_token==-1 ? (
  #l2_display_path="No WAV loaded"; l2_g_frames=0; l2_g_count=0; l2_g_overflow=0;
);
// A reanalysis preview remains WRITING and belongs exclusively to this GUI.
// It is never an audio source until Apply publishes it. MIDI uses active data.
l2_g_preview=l2_gui_loader.l2_status==4 && l2_gui_loader.l2_mode==1;
l2_g_active_count=l2_g_count;
l2_g_preview ? (
  l2_g_meta=l2_gui_loader.l2_meta; l2_g_count=l2_g_meta[7]; l2_g_overflow=l2_g_meta[8];
  memcpy(25240360,l2_g_meta+32,512);
  memcpy(25241360,l2_region_base+l2_gui_loader.l2_bank*l2_region_stride,l2_g_count*2);
  memcpy(25242060,l2_g_meta+10,6); memcpy(25242360,l2_region_base+l2_gui_loader.l2_bank*l2_region_stride+512,l2_g_count);
);
l2_g_selected=max(0,min(l2_g_count-1,floor(slider27)-1));
l2_g_dirty=abs(l2_detect7-25242060[0])>.001 || abs(l2_detect8-25242060[1])>.001 ||
        abs(l2_detect9-25242060[2])>.001 || abs(l2_detect10-25242060[3])>.001 ||
        abs(l2_detect11-25242060[4])>.001 || abs(l2_detect12-25242060[5])>.001;


);
function l2_edit_zoom(l2_factor) local(l2_mid,l2_span) (
  l2_mid=(l2_edit_view_start+l2_edit_view_end)/2;l2_span=max(16,min(l2_edit_frames,(l2_edit_view_end-l2_edit_view_start)*l2_factor));
  l2_edit_view_start=max(0,min(l2_edit_frames-l2_span,floor(l2_mid-l2_span/2)));l2_edit_view_end=l2_edit_view_start+l2_span;
);
function l2_edit_pan(l2_direction) local(l2_span) (
  l2_span=l2_edit_view_end-l2_edit_view_start;l2_edit_view_start=max(0,min(l2_edit_frames-l2_span,floor(l2_edit_view_start+l2_direction*l2_span*.5)));l2_edit_view_end=l2_edit_view_start+l2_span;
);
function l2_choose_region(l2_index,l2_audition) (
  slider27=max(1,l2_index+1); slider_automate(slider27,1);
  l2_audition ? atomic_set(l2_preview_request,1);
);
function l2_card() local(l2_x,l2_i,l2_c) (
  l2_x=20+1*267;
  master_rect(l2_x,92,259,142,.095,.12,.15);
  master_selected==1 ? master_rect(l2_x,92,259,3,.38,.83,.76);
  sprintf(#l2_card_title,"0%d   LAYER %d",2,2);
  master_text(l2_x+12,104,150,#l2_card_title,13,master_selected==1);
  l2_gui_loader.l2_status==1 ? sprintf(#l2_card_status,"LOAD %.0f%%",100*l2_gui_loader.l2_read_items/max(1,l2_gui_loader.l2_items)) :
  l2_gui_loader.l2_status==3 ? #l2_card_status="DETECTING" :
  l2_gui_loader.l2_status==4 ? #l2_card_status="PREVIEW" :
