function master_clear_layers() (
l1_edit_discard(); l1_gui_loader.l1_cancel_load(); atomic_add(l1_latest_request,1); l1_gui_loader.l1_status=0; l1_restore_failed=0; #l1_ui_message="";
l2_edit_discard(); l2_gui_loader.l2_cancel_load(); atomic_add(l2_latest_request,1); l2_gui_loader.l2_status=0; l2_restore_failed=0; #l2_ui_message="";
l3_edit_discard(); l3_gui_loader.l3_cancel_load(); atomic_add(l3_latest_request,1); l3_gui_loader.l3_status=0; l3_restore_failed=0; #l3_ui_message="";
l4_edit_discard(); l4_gui_loader.l4_cancel_load(); atomic_add(l4_latest_request,1); l4_gui_loader.l4_status=0; l4_restore_failed=0; #l4_ui_message="";
atomic_set(master_clear_request,1);sliderchange(-1););

master_visible=!(gfx_ext_flags&2);
master_scale=max(.25,min(gfx_w/1100,gfx_h/720));
master_ox=(gfx_w-1100*master_scale)/2;master_oy=(gfx_h-720*master_scale)/2;
master_mx=(mouse_x-master_ox)/master_scale;master_my=(mouse_y-master_oy)/master_scale;
master_modal=master_focus>0;
master_click=(mouse_cap&1) && !(master_previous_mouse&1) && master_drag==0;
master_right_click=(mouse_cap&2) && !(master_previous_mouse&2) && master_drag==0;
master_selected=max(0,min(3,master_selected));
master_char=gfx_getchar();
master_keyboard_steps=0;
while(master_char>0 && master_keyboard_steps<32) (
  master_focus>0 ? (
    master_char==13 ? master_numeric_commit() :
    master_char==27 ? master_focus=0 :
    master_char==8 ? (strcpy_substr(#master_input,#master_input,0,max(0,strlen(#master_input)-1));master_input_fresh=0;) :
    (master_char>=48 && master_char<=57) || master_char==46 || master_char==45 || master_char==43 ? (
      master_input_fresh ? (#master_input="";master_input_fresh=0;);
      strlen(#master_input)<24 ? strcat(#master_input,sprintf(#master_key,"%c",master_char));
    );
  );
  master_char=gfx_getchar();master_keyboard_steps+=1;
);
// Cancel gestures on close/focus loss/resize, avoiding coordinate jumps.
master_visible && (gfx_getchar(65536)&2) ? master_has_focus=1 : master_has_focus=0;
(master_previous_scale>0 && master_previous_scale!=master_scale) || !master_visible || (master_was_focused && !master_has_focus) ? (
  master_finish();master_focus=0;
);
master_previous_scale=master_scale;master_was_focused=master_has_focus;
master_drag>0 && (mouse_cap&1) && master_visible ? (
  master_spec(master_drag);
  master_drag_norm=max(0,min(1,master_drag_norm+(master_drag_last_y-master_my)/180*((mouse_cap&8) ? .1 : 1)));
  master_drag_last_y=master_my;
  master_n=master_drag_norm;master_drag>=55 && master_drag<=62 ? master_n*=master_n;
  master_new=master_lo+master_n*(master_hi-master_lo);
  abs(master_get(master_drag)-master_new)>=master_step*.49 ? master_put(master_drag,master_new,0);
);
!(mouse_cap&1) ? master_finish();
// One bounded work chunk, including while the GUI is hidden.
