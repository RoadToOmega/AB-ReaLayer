@init
// Memory ownership: PCM/metadata immutable from READY until FREE.
// State: FREE=0, WRITING=1, READY=2, ACTIVE=3, RETIRED=4.
// Only audio retires ACTIVE banks. Readers pin by generation-tagged token.
// Loader functions use instance fields, not shared scratch locals, so GUI
// and serialization loaders can run in different contexts safely.
function l1_setup() (
  !l1_booted ? (
    l1_booted=1; l1_detect7=-36; l1_detect8=6; l1_detect9=80; l1_detect10=10; l1_detect11=3; l1_detect12=20;
    l1_bank_meta=1024; l1_bank_stride=1024; l1_bank_paths=8192;
    l1_region_base=12288; l1_region_stride=1024; l1_region_limit=256;
    l1_saved_regions=4096; l1_saved_settings=4700;
    l1_shuffle_base=7000; l1_saved_flags=5000;
    l1_edit_regions=48000; l1_edit_flags=48512; l1_edit_settings=49000;
    l1_voice_base=16384; l1_voice_stride=24; l1_voice_limit=16;
    l1_event_base=32768; l1_event_limit=2048;
    l1_pcm_base=65536; l1_bank_capacity=12582912;
    l1_memory_ok=__memtop()>=l1_pcm_base+2*l1_bank_capacity;
    l1_bank_paths[0]=#l1_bank_path_0; l1_bank_paths[1]=#l1_bank_path_1;
    l1_bank_paths[2]=#l1_bank_path_2;
    l1_active_token=0; l1_latest_request=0; l1_restore_request=0;
    l1_audio_restore_seen=0; l1_preview_request=0; l1_panic_request=0; l1_reset_request=0;
    l1_gui_loader.l1_handle=-1; l1_restore_loader.l1_handle=-1;
    #l1_ui_message="Drop a mono or stereo WAV to begin.";
    #l1_saved_path="";
  );
);

// Token generation never reused within an instance: generation * 4 + bank + 1.
function l1_token_bank(l1_token) ( (l1_token-1)%4; );

// Read-side pin. Confirming the token AFTER pinning prevents reading a
// retired/reused slot. Bounded retry: UI keeps its prior display on failure.
function l1_pin_active() instance(l1_t,l1_b,l1_m,l1_tries,l1_result) (
  l1_tries=0; l1_result=0;
  loop(8,
    !l1_result ? (
      l1_t=atomic_get(l1_active_token);
      l1_t>0 ? (
        l1_b=l1_token_bank(l1_t); l1_m=l1_bank_meta+l1_b*l1_bank_stride;
        atomic_add(l1_m[5],1);
        atomic_get(l1_active_token)==l1_t ? l1_result=l1_t : atomic_add(l1_m[5],-1);
      ) : l1_result=-1;
    );
  );
  l1_result;
);
function l1_unpin(l1_token) instance(l1_m) (
  l1_token>0 ? (l1_m=l1_bank_meta+l1_token_bank(l1_token)*l1_bank_stride; atomic_add(l1_m[5],-1););
);

// Loader status: 0 idle, 1 decoding, 2 published, 3 analysing, 4 held preview.
// mode: 0 auto-detect/publish, 1 reanalysis preview, 2 restore PCM only.
// Errors: -1 open, -2 format, -3 size, -4 buffers busy, -5 read/data,
// -6 cancelled/superseded, -7 changed source during restore.
function l1_cancel_load() instance(l1_handle,l1_bank,l1_meta,l1_status) (
  (l1_status==1 || l1_status==3 || l1_status==4) ? (
    l1_handle>=0 ? file_close(l1_handle);
    l1_handle=-1; atomic_set(l1_meta[0],0); l1_status=-6;
  );
);
function l1_begin_load(l1_path,l1_request_id,l1_expect_frames,l1_expect_ch,l1_expect_rate)
instance(l1_handle,l1_bank,l1_meta,l1_status,l1_request,l1_channels,l1_rate,l1_items,l1_read_items,
         l1_base,l1_n,l1_i,l1_j,l1_chunk,l1_got,l1_x,l1_frame,l1_bin,l1_peakoff,l1_expected_frames,
         l1_expected_ch,l1_expected_rate) (
  this.l1_cancel_load();
  l1_request=l1_request_id; l1_expected_frames=l1_expect_frames;
  l1_expected_ch=l1_expect_ch; l1_expected_rate=l1_expect_rate;
  l1_status=0; l1_bank=-1; l1_i=0;
  loop(l1_memory_ok ? 2 : 0,
    l1_bank<0 ? (
      l1_meta=l1_bank_meta+l1_i*l1_bank_stride;
      atomic_setifequal(l1_meta[0],0,1)==0 ? l1_bank=l1_i;
    );
    l1_i+=1;
  );
  l1_bank<0 ? l1_status=l1_memory_ok ? -4 : -9 : (
    l1_meta=l1_bank_meta+l1_bank*l1_bank_stride; l1_base=l1_pcm_base+l1_bank*l1_bank_capacity;
    l1_handle=matchi("*.wav",l1_path) ? file_open(l1_path) : -1;
    l1_handle<0 ? l1_status=-1 : (
      l1_channels=0; l1_rate=0; file_riff(l1_handle,l1_channels,l1_rate);
      l1_items=file_avail(l1_handle);
      (l1_channels!=1 && l1_channels!=2) || l1_rate<1000 || l1_rate>768000 ? l1_status=-2 :
      (l1_items<l1_channels*2 || l1_items>l1_bank_capacity || l1_items%l1_channels!=0) ? l1_status=-3 : (
        l1_expected_frames>0 && (l1_items/l1_channels!=l1_expected_frames || l1_channels!=l1_expected_ch || l1_rate!=l1_expected_rate) ? l1_status=-7 : (
          l1_read_items=0; l1_status=1;
          strcpy(l1_bank_paths[l1_bank],l1_path);
          l1_meta[1]=l1_items/l1_channels; l1_meta[2]=l1_channels; l1_meta[3]=l1_rate;
          l1_meta[4]=l1_request; l1_meta[6]=l1_items; l1_meta[7]=0; l1_meta[8]=0;
          l1_meta[10]=max(-80,min(-6,l1_detect7)); l1_meta[11]=max(1,min(24,l1_detect8));
          l1_meta[12]=max(1,min(1000,l1_detect9)); l1_meta[13]=max(1,min(1000,l1_detect10));
          l1_meta[14]=max(0,min(100,l1_detect11)); l1_meta[15]=max(0,min(500,l1_detect12));
          memset(l1_region_base+l1_bank*l1_region_stride+512,1,256);
          // Reader count is NOT reset: a failed stale pin can still be leaving.
          memset(l1_meta+32,0,512);
        );
      );
    );
    l1_status!=1 ? (
      l1_handle>=0 ? file_close(l1_handle);
      l1_handle=-1; atomic_set(l1_meta[0],0);
    );
  );
  l1_status;
);

// All detector state is namespaced per loader. No detector code runs in audio.
function l1_publish_bank() instance(l1_meta,l1_status,l1_request,l1_bank,l1_pi,l1_pn,l1_pr) (
  l1_request==atomic_get(l1_latest_request) ? (
    
    l1_pr=l1_region_base+l1_bank*l1_region_stride; l1_pi=0; l1_pn=0;
    loop(l1_meta[7], l1_pr[512+l1_pi]>0 ? (l1_pr[768+l1_pn]=l1_pi; l1_pn+=1;); l1_pi+=1;);
    l1_meta[16]=l1_pn;
    atomic_set(l1_meta[0],2); l1_status=2;
  ) : (atomic_set(l1_meta[0],0); l1_status=-6;);
);
function l1_finish_detection() instance(l1_meta,l1_status,l1_mode) (
  // Never expose a silently truncated set. Overflow keeps PCM for Whole WAV.
  l1_meta[8] ? l1_meta[7]=0;
  l1_mode==1 ? l1_status=4 : this.l1_publish_bank();
);
function l1_detector_begin()
instance(l1_meta,l1_bank,l1_rate,l1_base,l1_channels,l1_scan,l1_window_size,l1_window_count,l1_energy,
         l1_open_power,l1_close_power,l1_gap_frames,l1_min_frames,l1_pre_frames,l1_tail_frames,
         l1_is_open,l1_raw_start,l1_last_loud,l1_quiet_start,l1_regions,l1_previous_raw_end) (
  l1_scan=0; l1_window_size=max(1,floor(l1_rate*.001)); l1_window_count=0; l1_energy=0;
  l1_open_power=10^(l1_meta[10]/10); l1_close_power=10^((l1_meta[10]-l1_meta[11])/10);
  l1_gap_frames=max(1,ceil(l1_rate*l1_meta[12]*.001));
  l1_min_frames=max(1,ceil(l1_rate*l1_meta[13]*.001));
  l1_pre_frames=floor(l1_rate*l1_meta[14]*.001); l1_tail_frames=floor(l1_rate*l1_meta[15]*.001);
  l1_is_open=0; l1_raw_start=0; l1_last_loud=0; l1_quiet_start=-1; l1_previous_raw_end=0;
  l1_regions=l1_region_base+l1_bank*l1_region_stride; l1_meta[7]=0; l1_meta[8]=0;
);
function l1_detector_append(l1_raw_end)
instance(l1_meta,l1_raw_start,l1_min_frames,l1_pre_frames,l1_tail_frames,l1_regions,
         l1_start_frame,l1_end_frame,l1_previous_raw_end,l1_cut,l1_idx) (
  l1_raw_end-l1_raw_start>=l1_min_frames && !l1_meta[8] ? (
    l1_meta[7]>=l1_region_limit ? l1_meta[8]=1 : (
      l1_start_frame=max(0,l1_raw_start-l1_pre_frames);
      l1_end_frame=min(l1_meta[1],l1_raw_end+l1_tail_frames);
      // Resolve overlapping PADDING inside the actual quiet gap, preserving
      // both raw sounds. All ends are exclusive source-frame indices.
      l1_idx=l1_meta[7];
      l1_idx>0 && l1_start_frame<l1_regions[(l1_idx-1)*2+1] ? (
        l1_cut=max(l1_previous_raw_end,min(l1_raw_start,floor((l1_start_frame+l1_regions[(l1_idx-1)*2+1])/2)));
        l1_regions[(l1_idx-1)*2+1]=l1_cut; l1_start_frame=l1_cut;
      );
      l1_regions[l1_idx*2]=l1_start_frame; l1_regions[l1_idx*2+1]=l1_end_frame;
      l1_meta[7]+=1; l1_previous_raw_end=l1_raw_end;
    );
  );
);
function l1_detector_window()
instance(l1_meta,l1_scan,l1_window_count,l1_energy,l1_open_power,l1_close_power,l1_gap_frames,
         l1_is_open,l1_raw_start,l1_last_loud,l1_quiet_start,l1_power,l1_window_start) (
  l1_power=l1_energy/max(1,l1_window_count); l1_window_start=l1_scan-l1_window_count;
  !l1_is_open ? (
    l1_power>=l1_open_power ? (
      l1_is_open=1; l1_raw_start=l1_window_start; l1_last_loud=l1_scan; l1_quiet_start=-1;
    );
  ) : (
    l1_power>=l1_close_power ? (l1_last_loud=l1_scan; l1_quiet_start=-1;) : (
      l1_quiet_start<0 ? l1_quiet_start=l1_window_start;
      l1_scan-l1_quiet_start>=l1_gap_frames ? (
        this.l1_detector_append(l1_last_loud); l1_is_open=0; l1_quiet_start=-1;
      );
    );
  );
  l1_window_count=0; l1_energy=0;
);
function l1_detector_step()
instance(l1_meta,l1_status,l1_request,l1_base,l1_channels,l1_scan,l1_window_size,l1_window_count,
         l1_energy,l1_is_open,l1_last_loud,l1_remaining,l1_x0,l1_x1,l1_pointer) (
  l1_status==3 ? (
    l1_request!=atomic_get(l1_latest_request) ? this.l1_cancel_load() : (
      l1_remaining=min(16384,l1_meta[1]-l1_scan);
      loop(l1_remaining,
        l1_pointer=l1_base+l1_scan*l1_channels; l1_x0=l1_pointer[0];
        l1_x1=l1_channels==2 ? l1_pointer[1] : l1_x0;
        l1_energy+=max(l1_x0*l1_x0,l1_x1*l1_x1); l1_window_count+=1; l1_scan+=1;
        l1_window_count>=l1_window_size ? this.l1_detector_window();
      );
      l1_scan==l1_meta[1] ? (
        l1_window_count>0 ? this.l1_detector_window();
        l1_is_open ? (this.l1_detector_append(l1_last_loud); l1_is_open=0;);
        this.l1_finish_detection();
      );
    );
  );
  l1_status;
);

function l1_load_step()
instance(l1_handle,l1_bank,l1_meta,l1_status,l1_request,l1_channels,l1_rate,l1_items,l1_read_items,
         l1_base,l1_n,l1_i,l1_j,l1_chunk,l1_got,l1_x,l1_frame,l1_bin,l1_peakoff,l1_expected_frames,
         l1_expected_ch,l1_expected_rate,l1_mode) (
  l1_status==1 ? (
    l1_request!=atomic_get(l1_latest_request) ? this.l1_cancel_load() : (
      l1_chunk=min(16384,l1_items-l1_read_items);
      l1_got=file_mem(l1_handle,l1_base+l1_read_items,l1_chunk);
      l1_got!=l1_chunk ? l1_status=-5 : (
        l1_i=0;
        loop(l1_got,
          l1_x=l1_base[l1_read_items+l1_i];
          // Comparison also rejects NaN, infinity and implausible PCM values.
          !(abs(l1_x)<1000000) ? l1_status=-5;
          l1_frame=floor((l1_read_items+l1_i)/l1_channels);
          l1_bin=min(255,floor(l1_frame*256/l1_meta[1])); l1_peakoff=l1_meta+32+l1_bin*2;
          l1_peakoff[0]=min(l1_peakoff[0],l1_x); l1_peakoff[1]=max(l1_peakoff[1],l1_x);
          l1_i+=1;
        );
        l1_read_items+=l1_got;
      );
      l1_status<0 ? (
        file_close(l1_handle); l1_handle=-1; atomic_set(l1_meta[0],0);
      ) : l1_read_items==l1_items ? (
        file_close(l1_handle); l1_handle=-1;
        l1_request==atomic_get(l1_latest_request) ? (
          l1_mode==2 ? l1_status=4 : (this.l1_detector_begin(); l1_status=3;);
        ) : (atomic_set(l1_meta[0],0); l1_status=-6;);
      );
    );
  );
  l1_status==3 ? this.l1_detector_step();
  l1_status;
);

// Audio-only deterministic generator. Schrage reduction keeps every integer
// product in range without relying on EEL's integer-converting remainder.
// Separate instances isolate region selection from parameter randomisation.
function l1_next_random() instance(l1_state,l1_quotient) (
  l1_quotient=floor(l1_state/44488);
  l1_state=48271*(l1_state-l1_quotient*44488)-3399*l1_quotient;
  l1_state<=0 ? l1_state+=2147483647;
  (l1_state-1)/2147483646;
);
function l1_reset_sequence() (
  l1_reverse_rng.l1_state=1+((l1_seq_seed+7919)%2147483646); l1_audition_rng.l1_state=1+((l1_seq_seed+15485863)%2147483646); l1_region_rng.l1_state=l1_seq_seed;
  l1_variation_rng.l1_state=1+((l1_seq_seed+104729)%2147483646);
  l1_last_region=0; l1_seq_last=-1; l1_seq_triggers=0; l1_seq_bag_pos=0; l1_seq_bag_size=0;
  l1_seq_resets+=1;
);
function l1_select_region(l1_count) local(l1_index,l1_i,l1_j,l1_temp) (
  l1_seq_mode==4 ? l1_index=max(0,min(l1_count-1,floor(slider15)-1)) :
  l1_count==1 ? l1_index=0 :
  l1_seq_mode==0 ? (
    l1_seq_last>=0 && l1_seq_last<l1_count ? (
      l1_index=floor(l1_region_rng.l1_next_random()*(l1_count-1));
      l1_index>=l1_seq_last ? l1_index+=1;
    ) : l1_index=floor(l1_region_rng.l1_next_random()*l1_count);
  ) : l1_seq_mode==1 ? (
    l1_seq_bag_size!=l1_count || l1_seq_bag_pos>=l1_count ? (
      l1_i=0; loop(l1_count,l1_shuffle_base[l1_i]=l1_i; l1_i+=1;);
      l1_i=l1_count-1;
      loop(l1_count-1,
        l1_j=floor(l1_region_rng.l1_next_random()*(l1_i+1));
        l1_temp=l1_shuffle_base[l1_i]; l1_shuffle_base[l1_i]=l1_shuffle_base[l1_j]; l1_shuffle_base[l1_j]=l1_temp;
        l1_i-=1;
      );
      // Preserve no-repeat across cycle boundaries, not only inside each bag.
      l1_shuffle_base[0]==l1_seq_last ? (
        l1_j=1+floor(l1_region_rng.l1_next_random()*(l1_count-1));
        l1_temp=l1_shuffle_base[0]; l1_shuffle_base[0]=l1_shuffle_base[l1_j]; l1_shuffle_base[l1_j]=l1_temp;
      );
      l1_seq_bag_size=l1_count; l1_seq_bag_pos=0;
    );
    l1_index=l1_shuffle_base[l1_seq_bag_pos]; l1_seq_bag_pos+=1;
  ) : l1_seq_mode==2 ? l1_index=(l1_seq_last+1)%l1_count :
    l1_index=floor(l1_region_rng.l1_next_random()*l1_count);
  l1_seq_last=l1_index;
  l1_index;
);

// audition: 0 performance, 1 manual region, 2 manual whole WAV.
function l1_start_voice(l1_velocity,l1_audition) local(l1_v,l1_i,l1_chosen,l1_m,l1_b,l1_rs,l1_re,l1_rp,l1_ri,l1_dp,l1_dg,l1_db,l1_use_region) (
  l1_active_token>0 ? (
    l1_b=l1_token_bank(l1_active_token); l1_m=l1_bank_meta+l1_b*l1_bank_stride;
    l1_use_region=l1_audition ? l1_audition==1 : slider14<.5;
    (!l1_use_region || (l1_audition ? l1_m[7]>0 :
      (l1_m[16]>0 && (l1_seq_mode!=4 || (l1_region_base+l1_b*l1_region_stride)[512+max(0,min(l1_m[7]-1,floor(slider15)-1))]>0)))) ? (
    l1_chosen=-1; l1_i=0;
    loop(l1_voice_limit,
      l1_v=l1_voice_base+l1_i*l1_voice_stride;
      l1_chosen<0 && !l1_v[0] ? l1_chosen=l1_v;
      l1_i+=1;
    );
    l1_chosen<0 ? l1_dropped_voices+=1 : (
      // Admission happens BEFORE any selection or PRNG work. Rejected notes,
      // empty banks and manual auditions do not consume the MIDI sequence.
      l1_rs=0; l1_re=l1_m[1]; l1_ri=-1;
      l1_use_region ? (
        
        l1_ri=l1_audition || l1_seq_mode==4 ? max(0,min(l1_m[7]-1,floor(slider15)-1)) :
          (l1_region_base+l1_b*l1_region_stride)[768+l1_select_region(l1_m[16])];
        l1_rp=l1_region_base+l1_b*l1_region_stride; l1_rs=l1_rp[l1_ri*2]; l1_re=l1_rp[l1_ri*2+1];
      );
      l1_dp=0; l1_dg=0; l1_db=0;
      !l1_audition ? (
        // Always draw three values, even with zero amounts, so changing an
        // amount does not perturb the other modulation dimensions.
        l1_dp=(l1_variation_rng.l1_next_random()*2-1)*l1_random_pitch;
        l1_dg=(l1_variation_rng.l1_next_random()*2-1)*l1_random_gain;
        l1_db=(l1_variation_rng.l1_next_random()*2-1)*l1_random_pan;
        l1_seq_triggers+=1; l1_last_region=l1_ri+1;
      );
      l1_v=l1_chosen; l1_b=l1_token_bank(l1_active_token); l1_m=l1_bank_meta+l1_b*l1_bank_stride;
      l1_v[0]=1; l1_v[1]=l1_b; l1_v[2]=l1_rs; l1_v[3]=l1_re; l1_v[4]=l1_m[2];
      l1_v[5]=l1_m[3]; l1_v[6]=l1_velocity/127; l1_v[7]=0; l1_v[8]=1;
      l1_v[9]=max(1,srate*max(0.1,min(10,slider4))*0.001);
      l1_v[10]=l1_pcm_base+l1_b*l1_bank_capacity; l1_v[11]=0; l1_v[12]=l1_rs;
      l1_v[13]=2^(l1_dp/12); l1_v[14]=l1_db; l1_v[15]=l1_seq_triggers;
      l1_v[16]=0; l1_v[17]=1; l1_v[18]=1; l1_v[19]=0; l1_v[20]=l1_ri;
      l1_v[23]=(l1_audition ? l1_audition_rng.l1_next_random() : l1_reverse_rng.l1_next_random())*100<max(0,min(100,slider65)); l1_v[6]*=10^(l1_dg/20);
      l1_v[21]=max(l1_v[9],srate*max(0,min(2000,slider55))*.001);
      l1_v[22]=max(l1_v[9],srate*max(0,min(5000,slider56))*.001);
      l1_trigger_count+=1;
    );
    );
  );
);
function l1_release_all() local(l1_v,l1_i) (
  l1_i=0; loop(l1_voice_limit,
    l1_v=l1_voice_base+l1_i*l1_voice_stride; l1_v[0] ? l1_v[7]=1; l1_i+=1;
  );
);

ext_noinit=1;
ext_tail_size=-1;
// Do not clear memory on transport starts or after @serialize.
// TEST_INIT_HOOK (the test runner injects fixtures here in a temporary copy).


// GUI-owned editable copy; audio reads only immutable bank tables.
function l1_edit_select(l1_index) local(l1_s,l1_e,l1_pad) (
  l1_edit_selected=max(0,min(l1_edit_count-1,l1_index));
  l1_s=l1_edit_regions[l1_edit_selected*2]; l1_e=l1_edit_regions[l1_edit_selected*2+1];
  l1_pad=max(16,(l1_e-l1_s)*.15);
  l1_edit_view_start=max(0,floor(l1_s-l1_pad)); l1_edit_view_end=min(l1_edit_frames,ceil(l1_e+l1_pad));
  l1_edit_cursor=floor((l1_s+l1_e)/2);
);
function l1_edit_begin() local(l1_t,l1_m,l1_b) (
  !l1_edit_active && l1_gui_loader.l1_status!=1 && l1_gui_loader.l1_status!=3 && l1_gui_loader.l1_status!=4 ? (
    l1_t=l1_edit_reader.l1_pin_active();
    l1_t>0 ? (
      l1_b=l1_token_bank(l1_t); l1_m=l1_bank_meta+l1_b*l1_bank_stride;
      l1_edit_count=l1_m[7]; l1_edit_frames=l1_m[1]; l1_edit_channels=l1_m[2]; l1_edit_rate=l1_m[3];
      memcpy(l1_edit_regions,l1_region_base+l1_b*l1_region_stride,l1_edit_count*2);
      memcpy(l1_edit_flags,l1_region_base+l1_b*l1_region_stride+512,l1_edit_count);
      memcpy(l1_edit_settings,l1_m+10,6); strcpy(#l1_edit_path,l1_bank_paths[l1_b]);
      l1_edit_token=l1_t; l1_edit_reader.l1_unpin(l1_t);
      l1_edit_count>0 ? (l1_edit_active=1; l1_edit_pending=0; l1_edit_select(min(l1_edit_count-1,floor(slider15)-1)););
    );
  );
  l1_edit_active;
);
function l1_edit_boundary(l1_which,l1_frame) local(l1_i,l1_lo,l1_hi) (
  l1_edit_active && !l1_edit_pending ? (
    l1_i=l1_edit_selected; l1_frame=floor(l1_frame);
    l1_which==1 ? (
      l1_lo=l1_i>0 ? l1_edit_regions[(l1_i-1)*2+1] : 0;
      l1_hi=l1_edit_regions[l1_i*2+1]-1;
      l1_edit_regions[l1_i*2]=max(l1_lo,min(l1_hi,l1_frame));
    ) : (
      l1_lo=l1_edit_regions[l1_i*2]+1;
      l1_hi=l1_i+1<l1_edit_count ? l1_edit_regions[(l1_i+1)*2] : l1_edit_frames;
      l1_edit_regions[l1_i*2+1]=max(l1_lo,min(l1_hi,l1_frame));
    );
  );
);
function l1_edit_split() local(l1_i,l1_j,l1_s,l1_e,l1_c) (
  l1_i=l1_edit_selected; l1_s=l1_edit_regions[l1_i*2]; l1_e=l1_edit_regions[l1_i*2+1]; l1_c=floor(l1_edit_cursor);
  l1_edit_active && !l1_edit_pending && l1_edit_count<256 && l1_c>l1_s && l1_c<l1_e ? (
    l1_j=l1_edit_count;
    loop(l1_edit_count-l1_i-1,
      l1_edit_regions[l1_j*2]=l1_edit_regions[(l1_j-1)*2]; l1_edit_regions[l1_j*2+1]=l1_edit_regions[(l1_j-1)*2+1];
      l1_edit_flags[l1_j]=l1_edit_flags[l1_j-1]; l1_j-=1;
    );
    l1_edit_regions[l1_i*2+1]=l1_c; l1_edit_regions[(l1_i+1)*2]=l1_c; l1_edit_regions[(l1_i+1)*2+1]=l1_e;
    l1_edit_flags[l1_i+1]=l1_edit_flags[l1_i]; l1_edit_count+=1;
  );
);
function l1_edit_merge() local(l1_i,l1_j) (
  l1_i=l1_edit_selected;
  l1_edit_active && !l1_edit_pending && l1_i+1<l1_edit_count ? (
    l1_edit_regions[l1_i*2+1]=l1_edit_regions[(l1_i+1)*2+1]; l1_j=l1_i+1;
    loop(l1_edit_count-l1_i-2,
      l1_edit_regions[l1_j*2]=l1_edit_regions[(l1_j+1)*2]; l1_edit_regions[l1_j*2+1]=l1_edit_regions[(l1_j+1)*2+1];
      l1_edit_flags[l1_j]=l1_edit_flags[l1_j+1]; l1_j+=1;
    );
    l1_edit_count-=1; l1_edit_select(l1_i);
  );
);
function l1_edit_toggle() (
  l1_edit_active && !l1_edit_pending ? l1_edit_flags[l1_edit_selected]=!l1_edit_flags[l1_edit_selected];
);
function l1_edit_discard() (
  l1_edit_pending ? l1_gui_loader.l1_cancel_load();
  l1_edit_pending=0; l1_edit_active=0; l1_edit_drag=0;
);
function l1_edit_apply() local(l1_req) (
  l1_edit_active && !l1_edit_pending && atomic_get(l1_active_token)==l1_edit_token ? (
    l1_req=atomic_add(l1_latest_request,1); l1_gui_loader.l1_mode=2;
    l1_gui_loader.l1_begin_load(#l1_edit_path,l1_req,l1_edit_frames,l1_edit_channels,l1_edit_rate);
    l1_gui_loader.l1_status==1 ? l1_edit_pending=1;
  );
);
function l1_edit_service() local(l1_m,l1_rp) (
  l1_edit_active && atomic_get(l1_active_token)!=l1_edit_token ? l1_edit_discard();
  l1_edit_pending ? (
    l1_gui_loader.l1_status<0 ? l1_edit_pending=0;
    l1_gui_loader.l1_status==4 && l1_gui_loader.l1_mode==2 ? (
      l1_m=l1_gui_loader.l1_meta; l1_rp=l1_region_base+l1_gui_loader.l1_bank*l1_region_stride;
      l1_m[7]=l1_edit_count; l1_m[8]=0;
      memcpy(l1_rp,l1_edit_regions,l1_edit_count*2); memcpy(l1_rp+512,l1_edit_flags,l1_edit_count);
      memcpy(l1_m+10,l1_edit_settings,6);
      l1_gui_loader.l1_publish_bank();
      slider15=l1_edit_selected+1; sliderchange(slider15);
      l1_edit_pending=0; l1_edit_active=0; l1_edit_drag=0;
    );
  );
);

function l1_has_room() local(l1_i,l1_v,l1_room) (
  l1_room=0; l1_i=0; loop(l1_voice_limit,l1_v=l1_voice_base+l1_i*l1_voice_stride; !l1_v[0] ? l1_room=1; l1_i+=1;); l1_room;
);
function l1_participates() local(l1_m) (
  l1_m=l1_bank_meta+l1_token_bank(l1_active_token)*l1_bank_stride;
  l1_layer_audible && l1_active_token>0 && (slider14>=.5 || (l1_m[16]>0 &&
    (l1_seq_mode!=4 || (l1_region_base+l1_token_bank(l1_active_token)*l1_region_stride)[512+max(0,min(l1_m[7]-1,floor(slider15)-1))]>0)));
);

// Memory ownership: PCM/metadata immutable from READY until FREE.
// State: FREE=0, WRITING=1, READY=2, ACTIVE=3, RETIRED=4.
// Only audio retires ACTIVE banks. Readers pin by generation-tagged token.
// Loader functions use instance fields, not shared scratch locals, so GUI
// and serialization loaders can run in different contexts safely.
function l2_setup() (
  !l2_booted ? (
    l2_booted=1; l2_detect7=-36; l2_detect8=6; l2_detect9=80; l2_detect10=10; l2_detect11=3; l2_detect12=20;
    l2_bank_meta=25232384; l2_bank_stride=1024; l2_bank_paths=25239552;
    l2_region_base=25243648; l2_region_stride=1024; l2_region_limit=256;
    l2_saved_regions=25235456; l2_saved_settings=25236060;
    l2_shuffle_base=25238360; l2_saved_flags=25236360;
    l2_edit_regions=25279360; l2_edit_flags=25279872; l2_edit_settings=25280360;
    l2_voice_base=25247744; l2_voice_stride=24; l2_voice_limit=16;
    l2_event_base=25264128; l2_event_limit=2048;
    l2_pcm_base=25296896; l2_bank_capacity=12582912;
    l2_memory_ok=__memtop()>=l2_pcm_base+2*l2_bank_capacity;
    l2_bank_paths[0]=#l2_bank_path_0; l2_bank_paths[1]=#l2_bank_path_1;
    l2_bank_paths[2]=#l2_bank_path_2;
    l2_active_token=0; l2_latest_request=0; l2_restore_request=0;
    l2_audio_restore_seen=0; l2_preview_request=0; l2_panic_request=0; l2_reset_request=0;
    l2_gui_loader.l2_handle=-1; l2_restore_loader.l2_handle=-1;
    #l2_ui_message="Drop a mono or stereo WAV to begin.";
    #l2_saved_path="";
  );
);

// Token generation never reused within an instance: generation * 4 + bank + 1.
function l2_token_bank(l2_token) ( (l2_token-1)%4; );

// Read-side pin. Confirming the token AFTER pinning prevents reading a
// retired/reused slot. Bounded retry: UI keeps its prior display on failure.
function l2_pin_active() instance(l2_t,l2_b,l2_m,l2_tries,l2_result) (
  l2_tries=0; l2_result=0;
  loop(8,
    !l2_result ? (
      l2_t=atomic_get(l2_active_token);
      l2_t>0 ? (
        l2_b=l2_token_bank(l2_t); l2_m=l2_bank_meta+l2_b*l2_bank_stride;
        atomic_add(l2_m[5],1);
        atomic_get(l2_active_token)==l2_t ? l2_result=l2_t : atomic_add(l2_m[5],-1);
      ) : l2_result=-1;
    );
  );
  l2_result;
);
function l2_unpin(l2_token) instance(l2_m) (
  l2_token>0 ? (l2_m=l2_bank_meta+l2_token_bank(l2_token)*l2_bank_stride; atomic_add(l2_m[5],-1););
);

// Loader status: 0 idle, 1 decoding, 2 published, 3 analysing, 4 held preview.
// mode: 0 auto-detect/publish, 1 reanalysis preview, 2 restore PCM only.
// Errors: -1 open, -2 format, -3 size, -4 buffers busy, -5 read/data,
// -6 cancelled/superseded, -7 changed source during restore.
function l2_cancel_load() instance(l2_handle,l2_bank,l2_meta,l2_status) (
  (l2_status==1 || l2_status==3 || l2_status==4) ? (
    l2_handle>=0 ? file_close(l2_handle);
    l2_handle=-1; atomic_set(l2_meta[0],0); l2_status=-6;
  );
);
function l2_begin_load(l2_path,l2_request_id,l2_expect_frames,l2_expect_ch,l2_expect_rate)
instance(l2_handle,l2_bank,l2_meta,l2_status,l2_request,l2_channels,l2_rate,l2_items,l2_read_items,
         l2_base,l2_n,l2_i,l2_j,l2_chunk,l2_got,l2_x,l2_frame,l2_bin,l2_peakoff,l2_expected_frames,
         l2_expected_ch,l2_expected_rate) (
  this.l2_cancel_load();
  l2_request=l2_request_id; l2_expected_frames=l2_expect_frames;
  l2_expected_ch=l2_expect_ch; l2_expected_rate=l2_expect_rate;
  l2_status=0; l2_bank=-1; l2_i=0;
  loop(l2_memory_ok ? 2 : 0,
    l2_bank<0 ? (
      l2_meta=l2_bank_meta+l2_i*l2_bank_stride;
      atomic_setifequal(l2_meta[0],0,1)==0 ? l2_bank=l2_i;
    );
    l2_i+=1;
  );
  l2_bank<0 ? l2_status=l2_memory_ok ? -4 : -9 : (
    l2_meta=l2_bank_meta+l2_bank*l2_bank_stride; l2_base=l2_pcm_base+l2_bank*l2_bank_capacity;
    l2_handle=matchi("*.wav",l2_path) ? file_open(l2_path) : -1;
    l2_handle<0 ? l2_status=-1 : (
      l2_channels=0; l2_rate=0; file_riff(l2_handle,l2_channels,l2_rate);
      l2_items=file_avail(l2_handle);
      (l2_channels!=1 && l2_channels!=2) || l2_rate<1000 || l2_rate>768000 ? l2_status=-2 :
      (l2_items<l2_channels*2 || l2_items>l2_bank_capacity || l2_items%l2_channels!=0) ? l2_status=-3 : (
        l2_expected_frames>0 && (l2_items/l2_channels!=l2_expected_frames || l2_channels!=l2_expected_ch || l2_rate!=l2_expected_rate) ? l2_status=-7 : (
          l2_read_items=0; l2_status=1;
          strcpy(l2_bank_paths[l2_bank],l2_path);
          l2_meta[1]=l2_items/l2_channels; l2_meta[2]=l2_channels; l2_meta[3]=l2_rate;
          l2_meta[4]=l2_request; l2_meta[6]=l2_items; l2_meta[7]=0; l2_meta[8]=0;
          l2_meta[10]=max(-80,min(-6,l2_detect7)); l2_meta[11]=max(1,min(24,l2_detect8));
          l2_meta[12]=max(1,min(1000,l2_detect9)); l2_meta[13]=max(1,min(1000,l2_detect10));
          l2_meta[14]=max(0,min(100,l2_detect11)); l2_meta[15]=max(0,min(500,l2_detect12));
          memset(l2_region_base+l2_bank*l2_region_stride+512,1,256);
          // Reader count is NOT reset: a failed stale pin can still be leaving.
          memset(l2_meta+32,0,512);
        );
      );
    );
    l2_status!=1 ? (
      l2_handle>=0 ? file_close(l2_handle);
      l2_handle=-1; atomic_set(l2_meta[0],0);
    );
  );
  l2_status;
);

// All detector state is namespaced per loader. No detector code runs in audio.
function l2_publish_bank() instance(l2_meta,l2_status,l2_request,l2_bank,l2_pi,l2_pn,l2_pr) (
  l2_request==atomic_get(l2_latest_request) ? (
    
    l2_pr=l2_region_base+l2_bank*l2_region_stride; l2_pi=0; l2_pn=0;
    loop(l2_meta[7], l2_pr[512+l2_pi]>0 ? (l2_pr[768+l2_pn]=l2_pi; l2_pn+=1;); l2_pi+=1;);
    l2_meta[16]=l2_pn;
    atomic_set(l2_meta[0],2); l2_status=2;
  ) : (atomic_set(l2_meta[0],0); l2_status=-6;);
);
function l2_finish_detection() instance(l2_meta,l2_status,l2_mode) (
  // Never expose a silently truncated set. Overflow keeps PCM for Whole WAV.
  l2_meta[8] ? l2_meta[7]=0;
  l2_mode==1 ? l2_status=4 : this.l2_publish_bank();
);
function l2_detector_begin()
instance(l2_meta,l2_bank,l2_rate,l2_base,l2_channels,l2_scan,l2_window_size,l2_window_count,l2_energy,
         l2_open_power,l2_close_power,l2_gap_frames,l2_min_frames,l2_pre_frames,l2_tail_frames,
         l2_is_open,l2_raw_start,l2_last_loud,l2_quiet_start,l2_regions,l2_previous_raw_end) (
  l2_scan=0; l2_window_size=max(1,floor(l2_rate*.001)); l2_window_count=0; l2_energy=0;
  l2_open_power=10^(l2_meta[10]/10); l2_close_power=10^((l2_meta[10]-l2_meta[11])/10);
  l2_gap_frames=max(1,ceil(l2_rate*l2_meta[12]*.001));
  l2_min_frames=max(1,ceil(l2_rate*l2_meta[13]*.001));
  l2_pre_frames=floor(l2_rate*l2_meta[14]*.001); l2_tail_frames=floor(l2_rate*l2_meta[15]*.001);
  l2_is_open=0; l2_raw_start=0; l2_last_loud=0; l2_quiet_start=-1; l2_previous_raw_end=0;
  l2_regions=l2_region_base+l2_bank*l2_region_stride; l2_meta[7]=0; l2_meta[8]=0;
);
function l2_detector_append(l2_raw_end)
instance(l2_meta,l2_raw_start,l2_min_frames,l2_pre_frames,l2_tail_frames,l2_regions,
         l2_start_frame,l2_end_frame,l2_previous_raw_end,l2_cut,l2_idx) (
  l2_raw_end-l2_raw_start>=l2_min_frames && !l2_meta[8] ? (
    l2_meta[7]>=l2_region_limit ? l2_meta[8]=1 : (
      l2_start_frame=max(0,l2_raw_start-l2_pre_frames);
      l2_end_frame=min(l2_meta[1],l2_raw_end+l2_tail_frames);
      // Resolve overlapping PADDING inside the actual quiet gap, preserving
      // both raw sounds. All ends are exclusive source-frame indices.
      l2_idx=l2_meta[7];
      l2_idx>0 && l2_start_frame<l2_regions[(l2_idx-1)*2+1] ? (
        l2_cut=max(l2_previous_raw_end,min(l2_raw_start,floor((l2_start_frame+l2_regions[(l2_idx-1)*2+1])/2)));
        l2_regions[(l2_idx-1)*2+1]=l2_cut; l2_start_frame=l2_cut;
      );
      l2_regions[l2_idx*2]=l2_start_frame; l2_regions[l2_idx*2+1]=l2_end_frame;
      l2_meta[7]+=1; l2_previous_raw_end=l2_raw_end;
    );
  );
);
function l2_detector_window()
instance(l2_meta,l2_scan,l2_window_count,l2_energy,l2_open_power,l2_close_power,l2_gap_frames,
         l2_is_open,l2_raw_start,l2_last_loud,l2_quiet_start,l2_power,l2_window_start) (
  l2_power=l2_energy/max(1,l2_window_count); l2_window_start=l2_scan-l2_window_count;
  !l2_is_open ? (
    l2_power>=l2_open_power ? (
      l2_is_open=1; l2_raw_start=l2_window_start; l2_last_loud=l2_scan; l2_quiet_start=-1;
    );
  ) : (
    l2_power>=l2_close_power ? (l2_last_loud=l2_scan; l2_quiet_start=-1;) : (
      l2_quiet_start<0 ? l2_quiet_start=l2_window_start;
      l2_scan-l2_quiet_start>=l2_gap_frames ? (
        this.l2_detector_append(l2_last_loud); l2_is_open=0; l2_quiet_start=-1;
      );
    );
  );
  l2_window_count=0; l2_energy=0;
);
function l2_detector_step()
instance(l2_meta,l2_status,l2_request,l2_base,l2_channels,l2_scan,l2_window_size,l2_window_count,
         l2_energy,l2_is_open,l2_last_loud,l2_remaining,l2_x0,l2_x1,l2_pointer) (
  l2_status==3 ? (
    l2_request!=atomic_get(l2_latest_request) ? this.l2_cancel_load() : (
      l2_remaining=min(16384,l2_meta[1]-l2_scan);
      loop(l2_remaining,
        l2_pointer=l2_base+l2_scan*l2_channels; l2_x0=l2_pointer[0];
        l2_x1=l2_channels==2 ? l2_pointer[1] : l2_x0;
        l2_energy+=max(l2_x0*l2_x0,l2_x1*l2_x1); l2_window_count+=1; l2_scan+=1;
        l2_window_count>=l2_window_size ? this.l2_detector_window();
      );
      l2_scan==l2_meta[1] ? (
        l2_window_count>0 ? this.l2_detector_window();
        l2_is_open ? (this.l2_detector_append(l2_last_loud); l2_is_open=0;);
        this.l2_finish_detection();
      );
    );
  );
  l2_status;
);

function l2_load_step()
instance(l2_handle,l2_bank,l2_meta,l2_status,l2_request,l2_channels,l2_rate,l2_items,l2_read_items,
         l2_base,l2_n,l2_i,l2_j,l2_chunk,l2_got,l2_x,l2_frame,l2_bin,l2_peakoff,l2_expected_frames,
         l2_expected_ch,l2_expected_rate,l2_mode) (
  l2_status==1 ? (
    l2_request!=atomic_get(l2_latest_request) ? this.l2_cancel_load() : (
      l2_chunk=min(16384,l2_items-l2_read_items);
      l2_got=file_mem(l2_handle,l2_base+l2_read_items,l2_chunk);
      l2_got!=l2_chunk ? l2_status=-5 : (
        l2_i=0;
        loop(l2_got,
          l2_x=l2_base[l2_read_items+l2_i];
          // Comparison also rejects NaN, infinity and implausible PCM values.
          !(abs(l2_x)<1000000) ? l2_status=-5;
          l2_frame=floor((l2_read_items+l2_i)/l2_channels);
          l2_bin=min(255,floor(l2_frame*256/l2_meta[1])); l2_peakoff=l2_meta+32+l2_bin*2;
          l2_peakoff[0]=min(l2_peakoff[0],l2_x); l2_peakoff[1]=max(l2_peakoff[1],l2_x);
          l2_i+=1;
        );
        l2_read_items+=l2_got;
      );
      l2_status<0 ? (
        file_close(l2_handle); l2_handle=-1; atomic_set(l2_meta[0],0);
      ) : l2_read_items==l2_items ? (
        file_close(l2_handle); l2_handle=-1;
        l2_request==atomic_get(l2_latest_request) ? (
          l2_mode==2 ? l2_status=4 : (this.l2_detector_begin(); l2_status=3;);
        ) : (atomic_set(l2_meta[0],0); l2_status=-6;);
      );
    );
  );
  l2_status==3 ? this.l2_detector_step();
  l2_status;
);

// Audio-only deterministic generator. Schrage reduction keeps every integer
// product in range without relying on EEL's integer-converting remainder.
// Separate instances isolate region selection from parameter randomisation.
function l2_next_random() instance(l2_state,l2_quotient) (
  l2_quotient=floor(l2_state/44488);
  l2_state=48271*(l2_state-l2_quotient*44488)-3399*l2_quotient;
  l2_state<=0 ? l2_state+=2147483647;
  (l2_state-1)/2147483646;
);
function l2_reset_sequence() (
  l2_reverse_rng.l2_state=1+((l2_seq_seed+7919)%2147483646); l2_audition_rng.l2_state=1+((l2_seq_seed+15485863)%2147483646); l2_region_rng.l2_state=l2_seq_seed;
  l2_variation_rng.l2_state=1+((l2_seq_seed+104729)%2147483646);
  l2_last_region=0; l2_seq_last=-1; l2_seq_triggers=0; l2_seq_bag_pos=0; l2_seq_bag_size=0;
  l2_seq_resets+=1;
);
function l2_select_region(l2_count) local(l2_index,l2_i,l2_j,l2_temp) (
  l2_seq_mode==4 ? l2_index=max(0,min(l2_count-1,floor(slider27)-1)) :
  l2_count==1 ? l2_index=0 :
  l2_seq_mode==0 ? (
    l2_seq_last>=0 && l2_seq_last<l2_count ? (
      l2_index=floor(l2_region_rng.l2_next_random()*(l2_count-1));
      l2_index>=l2_seq_last ? l2_index+=1;
    ) : l2_index=floor(l2_region_rng.l2_next_random()*l2_count);
  ) : l2_seq_mode==1 ? (
    l2_seq_bag_size!=l2_count || l2_seq_bag_pos>=l2_count ? (
      l2_i=0; loop(l2_count,l2_shuffle_base[l2_i]=l2_i; l2_i+=1;);
      l2_i=l2_count-1;
      loop(l2_count-1,
        l2_j=floor(l2_region_rng.l2_next_random()*(l2_i+1));
        l2_temp=l2_shuffle_base[l2_i]; l2_shuffle_base[l2_i]=l2_shuffle_base[l2_j]; l2_shuffle_base[l2_j]=l2_temp;
        l2_i-=1;
      );
      // Preserve no-repeat across cycle boundaries, not only inside each bag.
      l2_shuffle_base[0]==l2_seq_last ? (
        l2_j=1+floor(l2_region_rng.l2_next_random()*(l2_count-1));
        l2_temp=l2_shuffle_base[0]; l2_shuffle_base[0]=l2_shuffle_base[l2_j]; l2_shuffle_base[l2_j]=l2_temp;
      );
      l2_seq_bag_size=l2_count; l2_seq_bag_pos=0;
    );
    l2_index=l2_shuffle_base[l2_seq_bag_pos]; l2_seq_bag_pos+=1;
  ) : l2_seq_mode==2 ? l2_index=(l2_seq_last+1)%l2_count :
    l2_index=floor(l2_region_rng.l2_next_random()*l2_count);
  l2_seq_last=l2_index;
  l2_index;
);

// audition: 0 performance, 1 manual region, 2 manual whole WAV.
function l2_start_voice(l2_velocity,l2_audition) local(l2_v,l2_i,l2_chosen,l2_m,l2_b,l2_rs,l2_re,l2_rp,l2_ri,l2_dp,l2_dg,l2_db,l2_use_region) (
  l2_active_token>0 ? (
    l2_b=l2_token_bank(l2_active_token); l2_m=l2_bank_meta+l2_b*l2_bank_stride;
    l2_use_region=l2_audition ? l2_audition==1 : slider26<.5;
    (!l2_use_region || (l2_audition ? l2_m[7]>0 :
      (l2_m[16]>0 && (l2_seq_mode!=4 || (l2_region_base+l2_b*l2_region_stride)[512+max(0,min(l2_m[7]-1,floor(slider27)-1))]>0)))) ? (
    l2_chosen=-1; l2_i=0;
    loop(l2_voice_limit,
      l2_v=l2_voice_base+l2_i*l2_voice_stride;
      l2_chosen<0 && !l2_v[0] ? l2_chosen=l2_v;
      l2_i+=1;
    );
    l2_chosen<0 ? l2_dropped_voices+=1 : (
      // Admission happens BEFORE any selection or PRNG work. Rejected notes,
      // empty banks and manual auditions do not consume the MIDI sequence.
      l2_rs=0; l2_re=l2_m[1]; l2_ri=-1;
      l2_use_region ? (
        
        l2_ri=l2_audition || l2_seq_mode==4 ? max(0,min(l2_m[7]-1,floor(slider27)-1)) :
          (l2_region_base+l2_b*l2_region_stride)[768+l2_select_region(l2_m[16])];
        l2_rp=l2_region_base+l2_b*l2_region_stride; l2_rs=l2_rp[l2_ri*2]; l2_re=l2_rp[l2_ri*2+1];
      );
      l2_dp=0; l2_dg=0; l2_db=0;
      !l2_audition ? (
        // Always draw three values, even with zero amounts, so changing an
        // amount does not perturb the other modulation dimensions.
        l2_dp=(l2_variation_rng.l2_next_random()*2-1)*l2_random_pitch;
        l2_dg=(l2_variation_rng.l2_next_random()*2-1)*l2_random_gain;
        l2_db=(l2_variation_rng.l2_next_random()*2-1)*l2_random_pan;
        l2_seq_triggers+=1; l2_last_region=l2_ri+1;
      );
      l2_v=l2_chosen; l2_b=l2_token_bank(l2_active_token); l2_m=l2_bank_meta+l2_b*l2_bank_stride;
      l2_v[0]=1; l2_v[1]=l2_b; l2_v[2]=l2_rs; l2_v[3]=l2_re; l2_v[4]=l2_m[2];
      l2_v[5]=l2_m[3]; l2_v[6]=l2_velocity/127; l2_v[7]=0; l2_v[8]=1;
      l2_v[9]=max(1,srate*max(0.1,min(10,slider4))*0.001);
      l2_v[10]=l2_pcm_base+l2_b*l2_bank_capacity; l2_v[11]=0; l2_v[12]=l2_rs;
      l2_v[13]=2^(l2_dp/12); l2_v[14]=l2_db; l2_v[15]=l2_seq_triggers;
      l2_v[16]=0; l2_v[17]=1; l2_v[18]=1; l2_v[19]=0; l2_v[20]=l2_ri;
      l2_v[23]=(l2_audition ? l2_audition_rng.l2_next_random() : l2_reverse_rng.l2_next_random())*100<max(0,min(100,slider66)); l2_v[6]*=10^(l2_dg/20);
      l2_v[21]=max(l2_v[9],srate*max(0,min(2000,slider57))*.001);
      l2_v[22]=max(l2_v[9],srate*max(0,min(5000,slider58))*.001);
      l2_trigger_count+=1;
    );
    );
  );
);
function l2_release_all() local(l2_v,l2_i) (
  l2_i=0; loop(l2_voice_limit,
    l2_v=l2_voice_base+l2_i*l2_voice_stride; l2_v[0] ? l2_v[7]=1; l2_i+=1;
  );
);

ext_noinit=1;
ext_tail_size=-1;
// Do not clear memory on transport starts or after @serialize.
// TEST_INIT_HOOK (the test runner injects fixtures here in a temporary copy).


// GUI-owned editable copy; audio reads only immutable bank tables.
function l2_edit_select(l2_index) local(l2_s,l2_e,l2_pad) (
  l2_edit_selected=max(0,min(l2_edit_count-1,l2_index));
  l2_s=l2_edit_regions[l2_edit_selected*2]; l2_e=l2_edit_regions[l2_edit_selected*2+1];
  l2_pad=max(16,(l2_e-l2_s)*.15);
  l2_edit_view_start=max(0,floor(l2_s-l2_pad)); l2_edit_view_end=min(l2_edit_frames,ceil(l2_e+l2_pad));
  l2_edit_cursor=floor((l2_s+l2_e)/2);
);
function l2_edit_begin() local(l2_t,l2_m,l2_b) (
  !l2_edit_active && l2_gui_loader.l2_status!=1 && l2_gui_loader.l2_status!=3 && l2_gui_loader.l2_status!=4 ? (
    l2_t=l2_edit_reader.l2_pin_active();
    l2_t>0 ? (
      l2_b=l2_token_bank(l2_t); l2_m=l2_bank_meta+l2_b*l2_bank_stride;
      l2_edit_count=l2_m[7]; l2_edit_frames=l2_m[1]; l2_edit_channels=l2_m[2]; l2_edit_rate=l2_m[3];
      memcpy(l2_edit_regions,l2_region_base+l2_b*l2_region_stride,l2_edit_count*2);
      memcpy(l2_edit_flags,l2_region_base+l2_b*l2_region_stride+512,l2_edit_count);
      memcpy(l2_edit_settings,l2_m+10,6); strcpy(#l2_edit_path,l2_bank_paths[l2_b]);
      l2_edit_token=l2_t; l2_edit_reader.l2_unpin(l2_t);
      l2_edit_count>0 ? (l2_edit_active=1; l2_edit_pending=0; l2_edit_select(min(l2_edit_count-1,floor(slider27)-1)););
    );
  );
  l2_edit_active;
);
function l2_edit_boundary(l2_which,l2_frame) local(l2_i,l2_lo,l2_hi) (
  l2_edit_active && !l2_edit_pending ? (
    l2_i=l2_edit_selected; l2_frame=floor(l2_frame);
    l2_which==1 ? (
      l2_lo=l2_i>0 ? l2_edit_regions[(l2_i-1)*2+1] : 0;
      l2_hi=l2_edit_regions[l2_i*2+1]-1;
      l2_edit_regions[l2_i*2]=max(l2_lo,min(l2_hi,l2_frame));
    ) : (
      l2_lo=l2_edit_regions[l2_i*2]+1;
      l2_hi=l2_i+1<l2_edit_count ? l2_edit_regions[(l2_i+1)*2] : l2_edit_frames;
      l2_edit_regions[l2_i*2+1]=max(l2_lo,min(l2_hi,l2_frame));
    );
  );
);
function l2_edit_split() local(l2_i,l2_j,l2_s,l2_e,l2_c) (
  l2_i=l2_edit_selected; l2_s=l2_edit_regions[l2_i*2]; l2_e=l2_edit_regions[l2_i*2+1]; l2_c=floor(l2_edit_cursor);
  l2_edit_active && !l2_edit_pending && l2_edit_count<256 && l2_c>l2_s && l2_c<l2_e ? (
    l2_j=l2_edit_count;
    loop(l2_edit_count-l2_i-1,
      l2_edit_regions[l2_j*2]=l2_edit_regions[(l2_j-1)*2]; l2_edit_regions[l2_j*2+1]=l2_edit_regions[(l2_j-1)*2+1];
      l2_edit_flags[l2_j]=l2_edit_flags[l2_j-1]; l2_j-=1;
    );
    l2_edit_regions[l2_i*2+1]=l2_c; l2_edit_regions[(l2_i+1)*2]=l2_c; l2_edit_regions[(l2_i+1)*2+1]=l2_e;
    l2_edit_flags[l2_i+1]=l2_edit_flags[l2_i]; l2_edit_count+=1;
  );
);
function l2_edit_merge() local(l2_i,l2_j) (
  l2_i=l2_edit_selected;
  l2_edit_active && !l2_edit_pending && l2_i+1<l2_edit_count ? (
    l2_edit_regions[l2_i*2+1]=l2_edit_regions[(l2_i+1)*2+1]; l2_j=l2_i+1;
    loop(l2_edit_count-l2_i-2,
      l2_edit_regions[l2_j*2]=l2_edit_regions[(l2_j+1)*2]; l2_edit_regions[l2_j*2+1]=l2_edit_regions[(l2_j+1)*2+1];
      l2_edit_flags[l2_j]=l2_edit_flags[l2_j+1]; l2_j+=1;
    );
    l2_edit_count-=1; l2_edit_select(l2_i);
  );
);
function l2_edit_toggle() (
  l2_edit_active && !l2_edit_pending ? l2_edit_flags[l2_edit_selected]=!l2_edit_flags[l2_edit_selected];
);
function l2_edit_discard() (
  l2_edit_pending ? l2_gui_loader.l2_cancel_load();
  l2_edit_pending=0; l2_edit_active=0; l2_edit_drag=0;
);
function l2_edit_apply() local(l2_req) (
  l2_edit_active && !l2_edit_pending && atomic_get(l2_active_token)==l2_edit_token ? (
    l2_req=atomic_add(l2_latest_request,1); l2_gui_loader.l2_mode=2;
    l2_gui_loader.l2_begin_load(#l2_edit_path,l2_req,l2_edit_frames,l2_edit_channels,l2_edit_rate);
    l2_gui_loader.l2_status==1 ? l2_edit_pending=1;
  );
);
function l2_edit_service() local(l2_m,l2_rp) (
  l2_edit_active && atomic_get(l2_active_token)!=l2_edit_token ? l2_edit_discard();
  l2_edit_pending ? (
    l2_gui_loader.l2_status<0 ? l2_edit_pending=0;
    l2_gui_loader.l2_status==4 && l2_gui_loader.l2_mode==2 ? (
      l2_m=l2_gui_loader.l2_meta; l2_rp=l2_region_base+l2_gui_loader.l2_bank*l2_region_stride;
      l2_m[7]=l2_edit_count; l2_m[8]=0;
      memcpy(l2_rp,l2_edit_regions,l2_edit_count*2); memcpy(l2_rp+512,l2_edit_flags,l2_edit_count);
      memcpy(l2_m+10,l2_edit_settings,6);
      l2_gui_loader.l2_publish_bank();
      slider27=l2_edit_selected+1; sliderchange(slider27);
      l2_edit_pending=0; l2_edit_active=0; l2_edit_drag=0;
    );
  );
);

function l2_has_room() local(l2_i,l2_v,l2_room) (
  l2_room=0; l2_i=0; loop(l2_voice_limit,l2_v=l2_voice_base+l2_i*l2_voice_stride; !l2_v[0] ? l2_room=1; l2_i+=1;); l2_room;
);
function l2_participates() local(l2_m) (
  l2_m=l2_bank_meta+l2_token_bank(l2_active_token)*l2_bank_stride;
  l2_layer_audible && l2_active_token>0 && (slider26>=.5 || (l2_m[16]>0 &&
    (l2_seq_mode!=4 || (l2_region_base+l2_token_bank(l2_active_token)*l2_region_stride)[512+max(0,min(l2_m[7]-1,floor(slider27)-1))]>0)));
);

// Memory ownership: PCM/metadata immutable from READY until FREE.
// State: FREE=0, WRITING=1, READY=2, ACTIVE=3, RETIRED=4.
// Only audio retires ACTIVE banks. Readers pin by generation-tagged token.
// Loader functions use instance fields, not shared scratch locals, so GUI
// and serialization loaders can run in different contexts safely.
function l3_setup() (
  !l3_booted ? (
    l3_booted=1; l3_detect7=-36; l3_detect8=6; l3_detect9=80; l3_detect10=10; l3_detect11=3; l3_detect12=20;
    l3_bank_meta=50463744; l3_bank_stride=1024; l3_bank_paths=50470912;
    l3_region_base=50475008; l3_region_stride=1024; l3_region_limit=256;
    l3_saved_regions=50466816; l3_saved_settings=50467420;
    l3_shuffle_base=50469720; l3_saved_flags=50467720;
    l3_edit_regions=50510720; l3_edit_flags=50511232; l3_edit_settings=50511720;
    l3_voice_base=50479104; l3_voice_stride=24; l3_voice_limit=16;
    l3_event_base=50495488; l3_event_limit=2048;
    l3_pcm_base=50528256; l3_bank_capacity=12582912;
    l3_memory_ok=__memtop()>=l3_pcm_base+2*l3_bank_capacity;
    l3_bank_paths[0]=#l3_bank_path_0; l3_bank_paths[1]=#l3_bank_path_1;
    l3_bank_paths[2]=#l3_bank_path_2;
    l3_active_token=0; l3_latest_request=0; l3_restore_request=0;
    l3_audio_restore_seen=0; l3_preview_request=0; l3_panic_request=0; l3_reset_request=0;
    l3_gui_loader.l3_handle=-1; l3_restore_loader.l3_handle=-1;
    #l3_ui_message="Drop a mono or stereo WAV to begin.";
    #l3_saved_path="";
  );
);

// Token generation never reused within an instance: generation * 4 + bank + 1.
function l3_token_bank(l3_token) ( (l3_token-1)%4; );

// Read-side pin. Confirming the token AFTER pinning prevents reading a
// retired/reused slot. Bounded retry: UI keeps its prior display on failure.
function l3_pin_active() instance(l3_t,l3_b,l3_m,l3_tries,l3_result) (
  l3_tries=0; l3_result=0;
  loop(8,
    !l3_result ? (
      l3_t=atomic_get(l3_active_token);
      l3_t>0 ? (
        l3_b=l3_token_bank(l3_t); l3_m=l3_bank_meta+l3_b*l3_bank_stride;
        atomic_add(l3_m[5],1);
        atomic_get(l3_active_token)==l3_t ? l3_result=l3_t : atomic_add(l3_m[5],-1);
      ) : l3_result=-1;
    );
  );
  l3_result;
);
function l3_unpin(l3_token) instance(l3_m) (
  l3_token>0 ? (l3_m=l3_bank_meta+l3_token_bank(l3_token)*l3_bank_stride; atomic_add(l3_m[5],-1););
);

// Loader status: 0 idle, 1 decoding, 2 published, 3 analysing, 4 held preview.
// mode: 0 auto-detect/publish, 1 reanalysis preview, 2 restore PCM only.
// Errors: -1 open, -2 format, -3 size, -4 buffers busy, -5 read/data,
// -6 cancelled/superseded, -7 changed source during restore.
function l3_cancel_load() instance(l3_handle,l3_bank,l3_meta,l3_status) (
  (l3_status==1 || l3_status==3 || l3_status==4) ? (
    l3_handle>=0 ? file_close(l3_handle);
    l3_handle=-1; atomic_set(l3_meta[0],0); l3_status=-6;
  );
);
function l3_begin_load(l3_path,l3_request_id,l3_expect_frames,l3_expect_ch,l3_expect_rate)
instance(l3_handle,l3_bank,l3_meta,l3_status,l3_request,l3_channels,l3_rate,l3_items,l3_read_items,
         l3_base,l3_n,l3_i,l3_j,l3_chunk,l3_got,l3_x,l3_frame,l3_bin,l3_peakoff,l3_expected_frames,
         l3_expected_ch,l3_expected_rate) (
  this.l3_cancel_load();
  l3_request=l3_request_id; l3_expected_frames=l3_expect_frames;
  l3_expected_ch=l3_expect_ch; l3_expected_rate=l3_expect_rate;
  l3_status=0; l3_bank=-1; l3_i=0;
  loop(l3_memory_ok ? 2 : 0,
    l3_bank<0 ? (
      l3_meta=l3_bank_meta+l3_i*l3_bank_stride;
      atomic_setifequal(l3_meta[0],0,1)==0 ? l3_bank=l3_i;
    );
    l3_i+=1;
  );
  l3_bank<0 ? l3_status=l3_memory_ok ? -4 : -9 : (
    l3_meta=l3_bank_meta+l3_bank*l3_bank_stride; l3_base=l3_pcm_base+l3_bank*l3_bank_capacity;
    l3_handle=matchi("*.wav",l3_path) ? file_open(l3_path) : -1;
    l3_handle<0 ? l3_status=-1 : (
      l3_channels=0; l3_rate=0; file_riff(l3_handle,l3_channels,l3_rate);
      l3_items=file_avail(l3_handle);
      (l3_channels!=1 && l3_channels!=2) || l3_rate<1000 || l3_rate>768000 ? l3_status=-2 :
      (l3_items<l3_channels*2 || l3_items>l3_bank_capacity || l3_items%l3_channels!=0) ? l3_status=-3 : (
        l3_expected_frames>0 && (l3_items/l3_channels!=l3_expected_frames || l3_channels!=l3_expected_ch || l3_rate!=l3_expected_rate) ? l3_status=-7 : (
          l3_read_items=0; l3_status=1;
          strcpy(l3_bank_paths[l3_bank],l3_path);
          l3_meta[1]=l3_items/l3_channels; l3_meta[2]=l3_channels; l3_meta[3]=l3_rate;
          l3_meta[4]=l3_request; l3_meta[6]=l3_items; l3_meta[7]=0; l3_meta[8]=0;
          l3_meta[10]=max(-80,min(-6,l3_detect7)); l3_meta[11]=max(1,min(24,l3_detect8));
          l3_meta[12]=max(1,min(1000,l3_detect9)); l3_meta[13]=max(1,min(1000,l3_detect10));
          l3_meta[14]=max(0,min(100,l3_detect11)); l3_meta[15]=max(0,min(500,l3_detect12));
          memset(l3_region_base+l3_bank*l3_region_stride+512,1,256);
          // Reader count is NOT reset: a failed stale pin can still be leaving.
          memset(l3_meta+32,0,512);
        );
      );
    );
    l3_status!=1 ? (
      l3_handle>=0 ? file_close(l3_handle);
      l3_handle=-1; atomic_set(l3_meta[0],0);
    );
  );
  l3_status;
);

// All detector state is namespaced per loader. No detector code runs in audio.
function l3_publish_bank() instance(l3_meta,l3_status,l3_request,l3_bank,l3_pi,l3_pn,l3_pr) (
  l3_request==atomic_get(l3_latest_request) ? (
    
    l3_pr=l3_region_base+l3_bank*l3_region_stride; l3_pi=0; l3_pn=0;
    loop(l3_meta[7], l3_pr[512+l3_pi]>0 ? (l3_pr[768+l3_pn]=l3_pi; l3_pn+=1;); l3_pi+=1;);
    l3_meta[16]=l3_pn;
    atomic_set(l3_meta[0],2); l3_status=2;
  ) : (atomic_set(l3_meta[0],0); l3_status=-6;);
);
function l3_finish_detection() instance(l3_meta,l3_status,l3_mode) (
  // Never expose a silently truncated set. Overflow keeps PCM for Whole WAV.
  l3_meta[8] ? l3_meta[7]=0;
  l3_mode==1 ? l3_status=4 : this.l3_publish_bank();
);
function l3_detector_begin()
instance(l3_meta,l3_bank,l3_rate,l3_base,l3_channels,l3_scan,l3_window_size,l3_window_count,l3_energy,
         l3_open_power,l3_close_power,l3_gap_frames,l3_min_frames,l3_pre_frames,l3_tail_frames,
         l3_is_open,l3_raw_start,l3_last_loud,l3_quiet_start,l3_regions,l3_previous_raw_end) (
  l3_scan=0; l3_window_size=max(1,floor(l3_rate*.001)); l3_window_count=0; l3_energy=0;
  l3_open_power=10^(l3_meta[10]/10); l3_close_power=10^((l3_meta[10]-l3_meta[11])/10);
  l3_gap_frames=max(1,ceil(l3_rate*l3_meta[12]*.001));
  l3_min_frames=max(1,ceil(l3_rate*l3_meta[13]*.001));
  l3_pre_frames=floor(l3_rate*l3_meta[14]*.001); l3_tail_frames=floor(l3_rate*l3_meta[15]*.001);
  l3_is_open=0; l3_raw_start=0; l3_last_loud=0; l3_quiet_start=-1; l3_previous_raw_end=0;
  l3_regions=l3_region_base+l3_bank*l3_region_stride; l3_meta[7]=0; l3_meta[8]=0;
);
function l3_detector_append(l3_raw_end)
instance(l3_meta,l3_raw_start,l3_min_frames,l3_pre_frames,l3_tail_frames,l3_regions,
         l3_start_frame,l3_end_frame,l3_previous_raw_end,l3_cut,l3_idx) (
  l3_raw_end-l3_raw_start>=l3_min_frames && !l3_meta[8] ? (
    l3_meta[7]>=l3_region_limit ? l3_meta[8]=1 : (
      l3_start_frame=max(0,l3_raw_start-l3_pre_frames);
      l3_end_frame=min(l3_meta[1],l3_raw_end+l3_tail_frames);
      // Resolve overlapping PADDING inside the actual quiet gap, preserving
      // both raw sounds. All ends are exclusive source-frame indices.
      l3_idx=l3_meta[7];
      l3_idx>0 && l3_start_frame<l3_regions[(l3_idx-1)*2+1] ? (
        l3_cut=max(l3_previous_raw_end,min(l3_raw_start,floor((l3_start_frame+l3_regions[(l3_idx-1)*2+1])/2)));
        l3_regions[(l3_idx-1)*2+1]=l3_cut; l3_start_frame=l3_cut;
      );
      l3_regions[l3_idx*2]=l3_start_frame; l3_regions[l3_idx*2+1]=l3_end_frame;
      l3_meta[7]+=1; l3_previous_raw_end=l3_raw_end;
    );
  );
);
function l3_detector_window()
instance(l3_meta,l3_scan,l3_window_count,l3_energy,l3_open_power,l3_close_power,l3_gap_frames,
         l3_is_open,l3_raw_start,l3_last_loud,l3_quiet_start,l3_power,l3_window_start) (
  l3_power=l3_energy/max(1,l3_window_count); l3_window_start=l3_scan-l3_window_count;
  !l3_is_open ? (
    l3_power>=l3_open_power ? (
      l3_is_open=1; l3_raw_start=l3_window_start; l3_last_loud=l3_scan; l3_quiet_start=-1;
    );
  ) : (
    l3_power>=l3_close_power ? (l3_last_loud=l3_scan; l3_quiet_start=-1;) : (
      l3_quiet_start<0 ? l3_quiet_start=l3_window_start;
      l3_scan-l3_quiet_start>=l3_gap_frames ? (
        this.l3_detector_append(l3_last_loud); l3_is_open=0; l3_quiet_start=-1;
      );
    );
  );
  l3_window_count=0; l3_energy=0;
);
function l3_detector_step()
instance(l3_meta,l3_status,l3_request,l3_base,l3_channels,l3_scan,l3_window_size,l3_window_count,
         l3_energy,l3_is_open,l3_last_loud,l3_remaining,l3_x0,l3_x1,l3_pointer) (
  l3_status==3 ? (
    l3_request!=atomic_get(l3_latest_request) ? this.l3_cancel_load() : (
      l3_remaining=min(16384,l3_meta[1]-l3_scan);
      loop(l3_remaining,
        l3_pointer=l3_base+l3_scan*l3_channels; l3_x0=l3_pointer[0];
        l3_x1=l3_channels==2 ? l3_pointer[1] : l3_x0;
        l3_energy+=max(l3_x0*l3_x0,l3_x1*l3_x1); l3_window_count+=1; l3_scan+=1;
        l3_window_count>=l3_window_size ? this.l3_detector_window();
      );
      l3_scan==l3_meta[1] ? (
        l3_window_count>0 ? this.l3_detector_window();
        l3_is_open ? (this.l3_detector_append(l3_last_loud); l3_is_open=0;);
        this.l3_finish_detection();
      );
    );
  );
  l3_status;
);

function l3_load_step()
instance(l3_handle,l3_bank,l3_meta,l3_status,l3_request,l3_channels,l3_rate,l3_items,l3_read_items,
         l3_base,l3_n,l3_i,l3_j,l3_chunk,l3_got,l3_x,l3_frame,l3_bin,l3_peakoff,l3_expected_frames,
         l3_expected_ch,l3_expected_rate,l3_mode) (
  l3_status==1 ? (
    l3_request!=atomic_get(l3_latest_request) ? this.l3_cancel_load() : (
      l3_chunk=min(16384,l3_items-l3_read_items);
      l3_got=file_mem(l3_handle,l3_base+l3_read_items,l3_chunk);
      l3_got!=l3_chunk ? l3_status=-5 : (
        l3_i=0;
        loop(l3_got,
          l3_x=l3_base[l3_read_items+l3_i];
          // Comparison also rejects NaN, infinity and implausible PCM values.
          !(abs(l3_x)<1000000) ? l3_status=-5;
          l3_frame=floor((l3_read_items+l3_i)/l3_channels);
          l3_bin=min(255,floor(l3_frame*256/l3_meta[1])); l3_peakoff=l3_meta+32+l3_bin*2;
          l3_peakoff[0]=min(l3_peakoff[0],l3_x); l3_peakoff[1]=max(l3_peakoff[1],l3_x);
          l3_i+=1;
        );
        l3_read_items+=l3_got;
      );
      l3_status<0 ? (
        file_close(l3_handle); l3_handle=-1; atomic_set(l3_meta[0],0);
      ) : l3_read_items==l3_items ? (
        file_close(l3_handle); l3_handle=-1;
        l3_request==atomic_get(l3_latest_request) ? (
          l3_mode==2 ? l3_status=4 : (this.l3_detector_begin(); l3_status=3;);
        ) : (atomic_set(l3_meta[0],0); l3_status=-6;);
      );
    );
  );
  l3_status==3 ? this.l3_detector_step();
  l3_status;
);

// Audio-only deterministic generator. Schrage reduction keeps every integer
// product in range without relying on EEL's integer-converting remainder.
// Separate instances isolate region selection from parameter randomisation.
function l3_next_random() instance(l3_state,l3_quotient) (
  l3_quotient=floor(l3_state/44488);
  l3_state=48271*(l3_state-l3_quotient*44488)-3399*l3_quotient;
  l3_state<=0 ? l3_state+=2147483647;
  (l3_state-1)/2147483646;
);
function l3_reset_sequence() (
  l3_reverse_rng.l3_state=1+((l3_seq_seed+7919)%2147483646); l3_audition_rng.l3_state=1+((l3_seq_seed+15485863)%2147483646); l3_region_rng.l3_state=l3_seq_seed;
  l3_variation_rng.l3_state=1+((l3_seq_seed+104729)%2147483646);
  l3_last_region=0; l3_seq_last=-1; l3_seq_triggers=0; l3_seq_bag_pos=0; l3_seq_bag_size=0;
  l3_seq_resets+=1;
);
function l3_select_region(l3_count) local(l3_index,l3_i,l3_j,l3_temp) (
  l3_seq_mode==4 ? l3_index=max(0,min(l3_count-1,floor(slider39)-1)) :
  l3_count==1 ? l3_index=0 :
  l3_seq_mode==0 ? (
    l3_seq_last>=0 && l3_seq_last<l3_count ? (
      l3_index=floor(l3_region_rng.l3_next_random()*(l3_count-1));
      l3_index>=l3_seq_last ? l3_index+=1;
    ) : l3_index=floor(l3_region_rng.l3_next_random()*l3_count);
  ) : l3_seq_mode==1 ? (
    l3_seq_bag_size!=l3_count || l3_seq_bag_pos>=l3_count ? (
      l3_i=0; loop(l3_count,l3_shuffle_base[l3_i]=l3_i; l3_i+=1;);
      l3_i=l3_count-1;
      loop(l3_count-1,
        l3_j=floor(l3_region_rng.l3_next_random()*(l3_i+1));
        l3_temp=l3_shuffle_base[l3_i]; l3_shuffle_base[l3_i]=l3_shuffle_base[l3_j]; l3_shuffle_base[l3_j]=l3_temp;
        l3_i-=1;
      );
      // Preserve no-repeat across cycle boundaries, not only inside each bag.
      l3_shuffle_base[0]==l3_seq_last ? (
        l3_j=1+floor(l3_region_rng.l3_next_random()*(l3_count-1));
        l3_temp=l3_shuffle_base[0]; l3_shuffle_base[0]=l3_shuffle_base[l3_j]; l3_shuffle_base[l3_j]=l3_temp;
      );
      l3_seq_bag_size=l3_count; l3_seq_bag_pos=0;
    );
    l3_index=l3_shuffle_base[l3_seq_bag_pos]; l3_seq_bag_pos+=1;
  ) : l3_seq_mode==2 ? l3_index=(l3_seq_last+1)%l3_count :
    l3_index=floor(l3_region_rng.l3_next_random()*l3_count);
  l3_seq_last=l3_index;
  l3_index;
);

// audition: 0 performance, 1 manual region, 2 manual whole WAV.
function l3_start_voice(l3_velocity,l3_audition) local(l3_v,l3_i,l3_chosen,l3_m,l3_b,l3_rs,l3_re,l3_rp,l3_ri,l3_dp,l3_dg,l3_db,l3_use_region) (
  l3_active_token>0 ? (
    l3_b=l3_token_bank(l3_active_token); l3_m=l3_bank_meta+l3_b*l3_bank_stride;
    l3_use_region=l3_audition ? l3_audition==1 : slider38<.5;
    (!l3_use_region || (l3_audition ? l3_m[7]>0 :
      (l3_m[16]>0 && (l3_seq_mode!=4 || (l3_region_base+l3_b*l3_region_stride)[512+max(0,min(l3_m[7]-1,floor(slider39)-1))]>0)))) ? (
    l3_chosen=-1; l3_i=0;
    loop(l3_voice_limit,
      l3_v=l3_voice_base+l3_i*l3_voice_stride;
      l3_chosen<0 && !l3_v[0] ? l3_chosen=l3_v;
      l3_i+=1;
    );
    l3_chosen<0 ? l3_dropped_voices+=1 : (
      // Admission happens BEFORE any selection or PRNG work. Rejected notes,
      // empty banks and manual auditions do not consume the MIDI sequence.
      l3_rs=0; l3_re=l3_m[1]; l3_ri=-1;
      l3_use_region ? (
        
        l3_ri=l3_audition || l3_seq_mode==4 ? max(0,min(l3_m[7]-1,floor(slider39)-1)) :
          (l3_region_base+l3_b*l3_region_stride)[768+l3_select_region(l3_m[16])];
        l3_rp=l3_region_base+l3_b*l3_region_stride; l3_rs=l3_rp[l3_ri*2]; l3_re=l3_rp[l3_ri*2+1];
      );
      l3_dp=0; l3_dg=0; l3_db=0;
      !l3_audition ? (
        // Always draw three values, even with zero amounts, so changing an
        // amount does not perturb the other modulation dimensions.
        l3_dp=(l3_variation_rng.l3_next_random()*2-1)*l3_random_pitch;
        l3_dg=(l3_variation_rng.l3_next_random()*2-1)*l3_random_gain;
        l3_db=(l3_variation_rng.l3_next_random()*2-1)*l3_random_pan;
        l3_seq_triggers+=1; l3_last_region=l3_ri+1;
      );
      l3_v=l3_chosen; l3_b=l3_token_bank(l3_active_token); l3_m=l3_bank_meta+l3_b*l3_bank_stride;
      l3_v[0]=1; l3_v[1]=l3_b; l3_v[2]=l3_rs; l3_v[3]=l3_re; l3_v[4]=l3_m[2];
      l3_v[5]=l3_m[3]; l3_v[6]=l3_velocity/127; l3_v[7]=0; l3_v[8]=1;
      l3_v[9]=max(1,srate*max(0.1,min(10,slider4))*0.001);
      l3_v[10]=l3_pcm_base+l3_b*l3_bank_capacity; l3_v[11]=0; l3_v[12]=l3_rs;
      l3_v[13]=2^(l3_dp/12); l3_v[14]=l3_db; l3_v[15]=l3_seq_triggers;
      l3_v[16]=0; l3_v[17]=1; l3_v[18]=1; l3_v[19]=0; l3_v[20]=l3_ri;
      l3_v[23]=(l3_audition ? l3_audition_rng.l3_next_random() : l3_reverse_rng.l3_next_random())*100<max(0,min(100,slider67)); l3_v[6]*=10^(l3_dg/20);
      l3_v[21]=max(l3_v[9],srate*max(0,min(2000,slider59))*.001);
      l3_v[22]=max(l3_v[9],srate*max(0,min(5000,slider60))*.001);
      l3_trigger_count+=1;
    );
    );
  );
);
function l3_release_all() local(l3_v,l3_i) (
  l3_i=0; loop(l3_voice_limit,
    l3_v=l3_voice_base+l3_i*l3_voice_stride; l3_v[0] ? l3_v[7]=1; l3_i+=1;
  );
);

ext_noinit=1;
ext_tail_size=-1;
// Do not clear memory on transport starts or after @serialize.
// TEST_INIT_HOOK (the test runner injects fixtures here in a temporary copy).


// GUI-owned editable copy; audio reads only immutable bank tables.
function l3_edit_select(l3_index) local(l3_s,l3_e,l3_pad) (
  l3_edit_selected=max(0,min(l3_edit_count-1,l3_index));
  l3_s=l3_edit_regions[l3_edit_selected*2]; l3_e=l3_edit_regions[l3_edit_selected*2+1];
  l3_pad=max(16,(l3_e-l3_s)*.15);
  l3_edit_view_start=max(0,floor(l3_s-l3_pad)); l3_edit_view_end=min(l3_edit_frames,ceil(l3_e+l3_pad));
  l3_edit_cursor=floor((l3_s+l3_e)/2);
);
function l3_edit_begin() local(l3_t,l3_m,l3_b) (
  !l3_edit_active && l3_gui_loader.l3_status!=1 && l3_gui_loader.l3_status!=3 && l3_gui_loader.l3_status!=4 ? (
    l3_t=l3_edit_reader.l3_pin_active();
    l3_t>0 ? (
      l3_b=l3_token_bank(l3_t); l3_m=l3_bank_meta+l3_b*l3_bank_stride;
      l3_edit_count=l3_m[7]; l3_edit_frames=l3_m[1]; l3_edit_channels=l3_m[2]; l3_edit_rate=l3_m[3];
      memcpy(l3_edit_regions,l3_region_base+l3_b*l3_region_stride,l3_edit_count*2);
      memcpy(l3_edit_flags,l3_region_base+l3_b*l3_region_stride+512,l3_edit_count);
      memcpy(l3_edit_settings,l3_m+10,6); strcpy(#l3_edit_path,l3_bank_paths[l3_b]);
      l3_edit_token=l3_t; l3_edit_reader.l3_unpin(l3_t);
      l3_edit_count>0 ? (l3_edit_active=1; l3_edit_pending=0; l3_edit_select(min(l3_edit_count-1,floor(slider39)-1)););
    );
  );
  l3_edit_active;
);
function l3_edit_boundary(l3_which,l3_frame) local(l3_i,l3_lo,l3_hi) (
  l3_edit_active && !l3_edit_pending ? (
    l3_i=l3_edit_selected; l3_frame=floor(l3_frame);
    l3_which==1 ? (
      l3_lo=l3_i>0 ? l3_edit_regions[(l3_i-1)*2+1] : 0;
      l3_hi=l3_edit_regions[l3_i*2+1]-1;
      l3_edit_regions[l3_i*2]=max(l3_lo,min(l3_hi,l3_frame));
    ) : (
      l3_lo=l3_edit_regions[l3_i*2]+1;
      l3_hi=l3_i+1<l3_edit_count ? l3_edit_regions[(l3_i+1)*2] : l3_edit_frames;
      l3_edit_regions[l3_i*2+1]=max(l3_lo,min(l3_hi,l3_frame));
    );
  );
);
function l3_edit_split() local(l3_i,l3_j,l3_s,l3_e,l3_c) (
  l3_i=l3_edit_selected; l3_s=l3_edit_regions[l3_i*2]; l3_e=l3_edit_regions[l3_i*2+1]; l3_c=floor(l3_edit_cursor);
  l3_edit_active && !l3_edit_pending && l3_edit_count<256 && l3_c>l3_s && l3_c<l3_e ? (
    l3_j=l3_edit_count;
    loop(l3_edit_count-l3_i-1,
      l3_edit_regions[l3_j*2]=l3_edit_regions[(l3_j-1)*2]; l3_edit_regions[l3_j*2+1]=l3_edit_regions[(l3_j-1)*2+1];
      l3_edit_flags[l3_j]=l3_edit_flags[l3_j-1]; l3_j-=1;
    );
    l3_edit_regions[l3_i*2+1]=l3_c; l3_edit_regions[(l3_i+1)*2]=l3_c; l3_edit_regions[(l3_i+1)*2+1]=l3_e;
    l3_edit_flags[l3_i+1]=l3_edit_flags[l3_i]; l3_edit_count+=1;
  );
);
function l3_edit_merge() local(l3_i,l3_j) (
  l3_i=l3_edit_selected;
  l3_edit_active && !l3_edit_pending && l3_i+1<l3_edit_count ? (
    l3_edit_regions[l3_i*2+1]=l3_edit_regions[(l3_i+1)*2+1]; l3_j=l3_i+1;
    loop(l3_edit_count-l3_i-2,
      l3_edit_regions[l3_j*2]=l3_edit_regions[(l3_j+1)*2]; l3_edit_regions[l3_j*2+1]=l3_edit_regions[(l3_j+1)*2+1];
      l3_edit_flags[l3_j]=l3_edit_flags[l3_j+1]; l3_j+=1;
    );
    l3_edit_count-=1; l3_edit_select(l3_i);
  );
);
function l3_edit_toggle() (
  l3_edit_active && !l3_edit_pending ? l3_edit_flags[l3_edit_selected]=!l3_edit_flags[l3_edit_selected];
);
function l3_edit_discard() (
  l3_edit_pending ? l3_gui_loader.l3_cancel_load();
  l3_edit_pending=0; l3_edit_active=0; l3_edit_drag=0;
);
function l3_edit_apply() local(l3_req) (
  l3_edit_active && !l3_edit_pending && atomic_get(l3_active_token)==l3_edit_token ? (
    l3_req=atomic_add(l3_latest_request,1); l3_gui_loader.l3_mode=2;
    l3_gui_loader.l3_begin_load(#l3_edit_path,l3_req,l3_edit_frames,l3_edit_channels,l3_edit_rate);
    l3_gui_loader.l3_status==1 ? l3_edit_pending=1;
  );
);
function l3_edit_service() local(l3_m,l3_rp) (
  l3_edit_active && atomic_get(l3_active_token)!=l3_edit_token ? l3_edit_discard();
  l3_edit_pending ? (
    l3_gui_loader.l3_status<0 ? l3_edit_pending=0;
    l3_gui_loader.l3_status==4 && l3_gui_loader.l3_mode==2 ? (
      l3_m=l3_gui_loader.l3_meta; l3_rp=l3_region_base+l3_gui_loader.l3_bank*l3_region_stride;
      l3_m[7]=l3_edit_count; l3_m[8]=0;
      memcpy(l3_rp,l3_edit_regions,l3_edit_count*2); memcpy(l3_rp+512,l3_edit_flags,l3_edit_count);
      memcpy(l3_m+10,l3_edit_settings,6);
      l3_gui_loader.l3_publish_bank();
      slider39=l3_edit_selected+1; sliderchange(slider39);
      l3_edit_pending=0; l3_edit_active=0; l3_edit_drag=0;
    );
  );
);

function l3_has_room() local(l3_i,l3_v,l3_room) (
  l3_room=0; l3_i=0; loop(l3_voice_limit,l3_v=l3_voice_base+l3_i*l3_voice_stride; !l3_v[0] ? l3_room=1; l3_i+=1;); l3_room;
);
function l3_participates() local(l3_m) (
  l3_m=l3_bank_meta+l3_token_bank(l3_active_token)*l3_bank_stride;
  l3_layer_audible && l3_active_token>0 && (slider38>=.5 || (l3_m[16]>0 &&
    (l3_seq_mode!=4 || (l3_region_base+l3_token_bank(l3_active_token)*l3_region_stride)[512+max(0,min(l3_m[7]-1,floor(slider39)-1))]>0)));
);

// Memory ownership: PCM/metadata immutable from READY until FREE.
// State: FREE=0, WRITING=1, READY=2, ACTIVE=3, RETIRED=4.
// Only audio retires ACTIVE banks. Readers pin by generation-tagged token.
// Loader functions use instance fields, not shared scratch locals, so GUI
// and serialization loaders can run in different contexts safely.
function l4_setup() (
  !l4_booted ? (
    l4_booted=1; l4_detect7=-36; l4_detect8=6; l4_detect9=80; l4_detect10=10; l4_detect11=3; l4_detect12=20;
    l4_bank_meta=75695104; l4_bank_stride=1024; l4_bank_paths=75702272;
    l4_region_base=75706368; l4_region_stride=1024; l4_region_limit=256;
    l4_saved_regions=75698176; l4_saved_settings=75698780;
    l4_shuffle_base=75701080; l4_saved_flags=75699080;
    l4_edit_regions=75742080; l4_edit_flags=75742592; l4_edit_settings=75743080;
    l4_voice_base=75710464; l4_voice_stride=24; l4_voice_limit=16;
    l4_event_base=75726848; l4_event_limit=2048;
    l4_pcm_base=75759616; l4_bank_capacity=12582912;
    l4_memory_ok=__memtop()>=l4_pcm_base+2*l4_bank_capacity;
    l4_bank_paths[0]=#l4_bank_path_0; l4_bank_paths[1]=#l4_bank_path_1;
    l4_bank_paths[2]=#l4_bank_path_2;
    l4_active_token=0; l4_latest_request=0; l4_restore_request=0;
    l4_audio_restore_seen=0; l4_preview_request=0; l4_panic_request=0; l4_reset_request=0;
    l4_gui_loader.l4_handle=-1; l4_restore_loader.l4_handle=-1;
    #l4_ui_message="Drop a mono or stereo WAV to begin.";
    #l4_saved_path="";
  );
);

// Token generation never reused within an instance: generation * 4 + bank + 1.
function l4_token_bank(l4_token) ( (l4_token-1)%4; );

// Read-side pin. Confirming the token AFTER pinning prevents reading a
// retired/reused slot. Bounded retry: UI keeps its prior display on failure.
function l4_pin_active() instance(l4_t,l4_b,l4_m,l4_tries,l4_result) (
  l4_tries=0; l4_result=0;
  loop(8,
    !l4_result ? (
      l4_t=atomic_get(l4_active_token);
      l4_t>0 ? (
        l4_b=l4_token_bank(l4_t); l4_m=l4_bank_meta+l4_b*l4_bank_stride;
        atomic_add(l4_m[5],1);
        atomic_get(l4_active_token)==l4_t ? l4_result=l4_t : atomic_add(l4_m[5],-1);
      ) : l4_result=-1;
    );
  );
  l4_result;
);
function l4_unpin(l4_token) instance(l4_m) (
  l4_token>0 ? (l4_m=l4_bank_meta+l4_token_bank(l4_token)*l4_bank_stride; atomic_add(l4_m[5],-1););
);

// Loader status: 0 idle, 1 decoding, 2 published, 3 analysing, 4 held preview.
// mode: 0 auto-detect/publish, 1 reanalysis preview, 2 restore PCM only.
// Errors: -1 open, -2 format, -3 size, -4 buffers busy, -5 read/data,
// -6 cancelled/superseded, -7 changed source during restore.
function l4_cancel_load() instance(l4_handle,l4_bank,l4_meta,l4_status) (
  (l4_status==1 || l4_status==3 || l4_status==4) ? (
    l4_handle>=0 ? file_close(l4_handle);
    l4_handle=-1; atomic_set(l4_meta[0],0); l4_status=-6;
  );
);
function l4_begin_load(l4_path,l4_request_id,l4_expect_frames,l4_expect_ch,l4_expect_rate)
instance(l4_handle,l4_bank,l4_meta,l4_status,l4_request,l4_channels,l4_rate,l4_items,l4_read_items,
         l4_base,l4_n,l4_i,l4_j,l4_chunk,l4_got,l4_x,l4_frame,l4_bin,l4_peakoff,l4_expected_frames,
         l4_expected_ch,l4_expected_rate) (
  this.l4_cancel_load();
  l4_request=l4_request_id; l4_expected_frames=l4_expect_frames;
  l4_expected_ch=l4_expect_ch; l4_expected_rate=l4_expect_rate;
  l4_status=0; l4_bank=-1; l4_i=0;
  loop(l4_memory_ok ? 2 : 0,
    l4_bank<0 ? (
      l4_meta=l4_bank_meta+l4_i*l4_bank_stride;
      atomic_setifequal(l4_meta[0],0,1)==0 ? l4_bank=l4_i;
    );
    l4_i+=1;
  );
  l4_bank<0 ? l4_status=l4_memory_ok ? -4 : -9 : (
    l4_meta=l4_bank_meta+l4_bank*l4_bank_stride; l4_base=l4_pcm_base+l4_bank*l4_bank_capacity;
    l4_handle=matchi("*.wav",l4_path) ? file_open(l4_path) : -1;
    l4_handle<0 ? l4_status=-1 : (
      l4_channels=0; l4_rate=0; file_riff(l4_handle,l4_channels,l4_rate);
      l4_items=file_avail(l4_handle);
      (l4_channels!=1 && l4_channels!=2) || l4_rate<1000 || l4_rate>768000 ? l4_status=-2 :
      (l4_items<l4_channels*2 || l4_items>l4_bank_capacity || l4_items%l4_channels!=0) ? l4_status=-3 : (
        l4_expected_frames>0 && (l4_items/l4_channels!=l4_expected_frames || l4_channels!=l4_expected_ch || l4_rate!=l4_expected_rate) ? l4_status=-7 : (
          l4_read_items=0; l4_status=1;
          strcpy(l4_bank_paths[l4_bank],l4_path);
          l4_meta[1]=l4_items/l4_channels; l4_meta[2]=l4_channels; l4_meta[3]=l4_rate;
          l4_meta[4]=l4_request; l4_meta[6]=l4_items; l4_meta[7]=0; l4_meta[8]=0;
          l4_meta[10]=max(-80,min(-6,l4_detect7)); l4_meta[11]=max(1,min(24,l4_detect8));
          l4_meta[12]=max(1,min(1000,l4_detect9)); l4_meta[13]=max(1,min(1000,l4_detect10));
          l4_meta[14]=max(0,min(100,l4_detect11)); l4_meta[15]=max(0,min(500,l4_detect12));
          memset(l4_region_base+l4_bank*l4_region_stride+512,1,256);
          // Reader count is NOT reset: a failed stale pin can still be leaving.
          memset(l4_meta+32,0,512);
        );
      );
    );
    l4_status!=1 ? (
      l4_handle>=0 ? file_close(l4_handle);
      l4_handle=-1; atomic_set(l4_meta[0],0);
    );
  );
  l4_status;
);

// All detector state is namespaced per loader. No detector code runs in audio.
function l4_publish_bank() instance(l4_meta,l4_status,l4_request,l4_bank,l4_pi,l4_pn,l4_pr) (
  l4_request==atomic_get(l4_latest_request) ? (
    
    l4_pr=l4_region_base+l4_bank*l4_region_stride; l4_pi=0; l4_pn=0;
    loop(l4_meta[7], l4_pr[512+l4_pi]>0 ? (l4_pr[768+l4_pn]=l4_pi; l4_pn+=1;); l4_pi+=1;);
    l4_meta[16]=l4_pn;
    atomic_set(l4_meta[0],2); l4_status=2;
  ) : (atomic_set(l4_meta[0],0); l4_status=-6;);
);
function l4_finish_detection() instance(l4_meta,l4_status,l4_mode) (
  // Never expose a silently truncated set. Overflow keeps PCM for Whole WAV.
  l4_meta[8] ? l4_meta[7]=0;
  l4_mode==1 ? l4_status=4 : this.l4_publish_bank();
);
function l4_detector_begin()
instance(l4_meta,l4_bank,l4_rate,l4_base,l4_channels,l4_scan,l4_window_size,l4_window_count,l4_energy,
         l4_open_power,l4_close_power,l4_gap_frames,l4_min_frames,l4_pre_frames,l4_tail_frames,
         l4_is_open,l4_raw_start,l4_last_loud,l4_quiet_start,l4_regions,l4_previous_raw_end) (
  l4_scan=0; l4_window_size=max(1,floor(l4_rate*.001)); l4_window_count=0; l4_energy=0;
  l4_open_power=10^(l4_meta[10]/10); l4_close_power=10^((l4_meta[10]-l4_meta[11])/10);
  l4_gap_frames=max(1,ceil(l4_rate*l4_meta[12]*.001));
  l4_min_frames=max(1,ceil(l4_rate*l4_meta[13]*.001));
  l4_pre_frames=floor(l4_rate*l4_meta[14]*.001); l4_tail_frames=floor(l4_rate*l4_meta[15]*.001);
  l4_is_open=0; l4_raw_start=0; l4_last_loud=0; l4_quiet_start=-1; l4_previous_raw_end=0;
  l4_regions=l4_region_base+l4_bank*l4_region_stride; l4_meta[7]=0; l4_meta[8]=0;
);
function l4_detector_append(l4_raw_end)
instance(l4_meta,l4_raw_start,l4_min_frames,l4_pre_frames,l4_tail_frames,l4_regions,
         l4_start_frame,l4_end_frame,l4_previous_raw_end,l4_cut,l4_idx) (
  l4_raw_end-l4_raw_start>=l4_min_frames && !l4_meta[8] ? (
    l4_meta[7]>=l4_region_limit ? l4_meta[8]=1 : (
      l4_start_frame=max(0,l4_raw_start-l4_pre_frames);
      l4_end_frame=min(l4_meta[1],l4_raw_end+l4_tail_frames);
      // Resolve overlapping PADDING inside the actual quiet gap, preserving
      // both raw sounds. All ends are exclusive source-frame indices.
      l4_idx=l4_meta[7];
      l4_idx>0 && l4_start_frame<l4_regions[(l4_idx-1)*2+1] ? (
        l4_cut=max(l4_previous_raw_end,min(l4_raw_start,floor((l4_start_frame+l4_regions[(l4_idx-1)*2+1])/2)));
        l4_regions[(l4_idx-1)*2+1]=l4_cut; l4_start_frame=l4_cut;
      );
      l4_regions[l4_idx*2]=l4_start_frame; l4_regions[l4_idx*2+1]=l4_end_frame;
      l4_meta[7]+=1; l4_previous_raw_end=l4_raw_end;
    );
  );
);
function l4_detector_window()
instance(l4_meta,l4_scan,l4_window_count,l4_energy,l4_open_power,l4_close_power,l4_gap_frames,
         l4_is_open,l4_raw_start,l4_last_loud,l4_quiet_start,l4_power,l4_window_start) (
  l4_power=l4_energy/max(1,l4_window_count); l4_window_start=l4_scan-l4_window_count;
  !l4_is_open ? (
    l4_power>=l4_open_power ? (
      l4_is_open=1; l4_raw_start=l4_window_start; l4_last_loud=l4_scan; l4_quiet_start=-1;
    );
  ) : (
    l4_power>=l4_close_power ? (l4_last_loud=l4_scan; l4_quiet_start=-1;) : (
      l4_quiet_start<0 ? l4_quiet_start=l4_window_start;
      l4_scan-l4_quiet_start>=l4_gap_frames ? (
        this.l4_detector_append(l4_last_loud); l4_is_open=0; l4_quiet_start=-1;
      );
    );
  );
  l4_window_count=0; l4_energy=0;
);
function l4_detector_step()
instance(l4_meta,l4_status,l4_request,l4_base,l4_channels,l4_scan,l4_window_size,l4_window_count,
         l4_energy,l4_is_open,l4_last_loud,l4_remaining,l4_x0,l4_x1,l4_pointer) (
  l4_status==3 ? (
    l4_request!=atomic_get(l4_latest_request) ? this.l4_cancel_load() : (
      l4_remaining=min(16384,l4_meta[1]-l4_scan);
      loop(l4_remaining,
        l4_pointer=l4_base+l4_scan*l4_channels; l4_x0=l4_pointer[0];
        l4_x1=l4_channels==2 ? l4_pointer[1] : l4_x0;
        l4_energy+=max(l4_x0*l4_x0,l4_x1*l4_x1); l4_window_count+=1; l4_scan+=1;
        l4_window_count>=l4_window_size ? this.l4_detector_window();
      );
      l4_scan==l4_meta[1] ? (
        l4_window_count>0 ? this.l4_detector_window();
        l4_is_open ? (this.l4_detector_append(l4_last_loud); l4_is_open=0;);
        this.l4_finish_detection();
      );
    );
  );
  l4_status;
);

function l4_load_step()
instance(l4_handle,l4_bank,l4_meta,l4_status,l4_request,l4_channels,l4_rate,l4_items,l4_read_items,
         l4_base,l4_n,l4_i,l4_j,l4_chunk,l4_got,l4_x,l4_frame,l4_bin,l4_peakoff,l4_expected_frames,
         l4_expected_ch,l4_expected_rate,l4_mode) (
  l4_status==1 ? (
    l4_request!=atomic_get(l4_latest_request) ? this.l4_cancel_load() : (
      l4_chunk=min(16384,l4_items-l4_read_items);
      l4_got=file_mem(l4_handle,l4_base+l4_read_items,l4_chunk);
      l4_got!=l4_chunk ? l4_status=-5 : (
        l4_i=0;
        loop(l4_got,
          l4_x=l4_base[l4_read_items+l4_i];
          // Comparison also rejects NaN, infinity and implausible PCM values.
          !(abs(l4_x)<1000000) ? l4_status=-5;
          l4_frame=floor((l4_read_items+l4_i)/l4_channels);
          l4_bin=min(255,floor(l4_frame*256/l4_meta[1])); l4_peakoff=l4_meta+32+l4_bin*2;
          l4_peakoff[0]=min(l4_peakoff[0],l4_x); l4_peakoff[1]=max(l4_peakoff[1],l4_x);
          l4_i+=1;
        );
        l4_read_items+=l4_got;
      );
      l4_status<0 ? (
        file_close(l4_handle); l4_handle=-1; atomic_set(l4_meta[0],0);
      ) : l4_read_items==l4_items ? (
        file_close(l4_handle); l4_handle=-1;
        l4_request==atomic_get(l4_latest_request) ? (
          l4_mode==2 ? l4_status=4 : (this.l4_detector_begin(); l4_status=3;);
        ) : (atomic_set(l4_meta[0],0); l4_status=-6;);
      );
    );
  );
  l4_status==3 ? this.l4_detector_step();
  l4_status;
);

// Audio-only deterministic generator. Schrage reduction keeps every integer
// product in range without relying on EEL's integer-converting remainder.
// Separate instances isolate region selection from parameter randomisation.
function l4_next_random() instance(l4_state,l4_quotient) (
  l4_quotient=floor(l4_state/44488);
  l4_state=48271*(l4_state-l4_quotient*44488)-3399*l4_quotient;
  l4_state<=0 ? l4_state+=2147483647;
  (l4_state-1)/2147483646;
);
function l4_reset_sequence() (
  l4_reverse_rng.l4_state=1+((l4_seq_seed+7919)%2147483646); l4_audition_rng.l4_state=1+((l4_seq_seed+15485863)%2147483646); l4_region_rng.l4_state=l4_seq_seed;
  l4_variation_rng.l4_state=1+((l4_seq_seed+104729)%2147483646);
  l4_last_region=0; l4_seq_last=-1; l4_seq_triggers=0; l4_seq_bag_pos=0; l4_seq_bag_size=0;
  l4_seq_resets+=1;
);
function l4_select_region(l4_count) local(l4_index,l4_i,l4_j,l4_temp) (
  l4_seq_mode==4 ? l4_index=max(0,min(l4_count-1,floor(slider51)-1)) :
  l4_count==1 ? l4_index=0 :
  l4_seq_mode==0 ? (
    l4_seq_last>=0 && l4_seq_last<l4_count ? (
      l4_index=floor(l4_region_rng.l4_next_random()*(l4_count-1));
      l4_index>=l4_seq_last ? l4_index+=1;
    ) : l4_index=floor(l4_region_rng.l4_next_random()*l4_count);
  ) : l4_seq_mode==1 ? (
    l4_seq_bag_size!=l4_count || l4_seq_bag_pos>=l4_count ? (
      l4_i=0; loop(l4_count,l4_shuffle_base[l4_i]=l4_i; l4_i+=1;);
      l4_i=l4_count-1;
      loop(l4_count-1,
        l4_j=floor(l4_region_rng.l4_next_random()*(l4_i+1));
        l4_temp=l4_shuffle_base[l4_i]; l4_shuffle_base[l4_i]=l4_shuffle_base[l4_j]; l4_shuffle_base[l4_j]=l4_temp;
        l4_i-=1;
      );
      // Preserve no-repeat across cycle boundaries, not only inside each bag.
      l4_shuffle_base[0]==l4_seq_last ? (
        l4_j=1+floor(l4_region_rng.l4_next_random()*(l4_count-1));
        l4_temp=l4_shuffle_base[0]; l4_shuffle_base[0]=l4_shuffle_base[l4_j]; l4_shuffle_base[l4_j]=l4_temp;
      );
      l4_seq_bag_size=l4_count; l4_seq_bag_pos=0;
    );
    l4_index=l4_shuffle_base[l4_seq_bag_pos]; l4_seq_bag_pos+=1;
  ) : l4_seq_mode==2 ? l4_index=(l4_seq_last+1)%l4_count :
    l4_index=floor(l4_region_rng.l4_next_random()*l4_count);
  l4_seq_last=l4_index;
  l4_index;
);

// audition: 0 performance, 1 manual region, 2 manual whole WAV.
function l4_start_voice(l4_velocity,l4_audition) local(l4_v,l4_i,l4_chosen,l4_m,l4_b,l4_rs,l4_re,l4_rp,l4_ri,l4_dp,l4_dg,l4_db,l4_use_region) (
  l4_active_token>0 ? (
    l4_b=l4_token_bank(l4_active_token); l4_m=l4_bank_meta+l4_b*l4_bank_stride;
    l4_use_region=l4_audition ? l4_audition==1 : slider50<.5;
    (!l4_use_region || (l4_audition ? l4_m[7]>0 :
      (l4_m[16]>0 && (l4_seq_mode!=4 || (l4_region_base+l4_b*l4_region_stride)[512+max(0,min(l4_m[7]-1,floor(slider51)-1))]>0)))) ? (
    l4_chosen=-1; l4_i=0;
    loop(l4_voice_limit,
      l4_v=l4_voice_base+l4_i*l4_voice_stride;
      l4_chosen<0 && !l4_v[0] ? l4_chosen=l4_v;
      l4_i+=1;
    );
    l4_chosen<0 ? l4_dropped_voices+=1 : (
      // Admission happens BEFORE any selection or PRNG work. Rejected notes,
      // empty banks and manual auditions do not consume the MIDI sequence.
      l4_rs=0; l4_re=l4_m[1]; l4_ri=-1;
      l4_use_region ? (
        
        l4_ri=l4_audition || l4_seq_mode==4 ? max(0,min(l4_m[7]-1,floor(slider51)-1)) :
          (l4_region_base+l4_b*l4_region_stride)[768+l4_select_region(l4_m[16])];
        l4_rp=l4_region_base+l4_b*l4_region_stride; l4_rs=l4_rp[l4_ri*2]; l4_re=l4_rp[l4_ri*2+1];
      );
      l4_dp=0; l4_dg=0; l4_db=0;
      !l4_audition ? (
        // Always draw three values, even with zero amounts, so changing an
        // amount does not perturb the other modulation dimensions.
        l4_dp=(l4_variation_rng.l4_next_random()*2-1)*l4_random_pitch;
        l4_dg=(l4_variation_rng.l4_next_random()*2-1)*l4_random_gain;
        l4_db=(l4_variation_rng.l4_next_random()*2-1)*l4_random_pan;
        l4_seq_triggers+=1; l4_last_region=l4_ri+1;
