      );l4_i+=1;);
      master_button(20,602,76,"Page <",l4_g_page>0,0) ? l4_g_page-=1;
      master_button(102,602,76,"Page >",l4_g_page+1<l4_g_pages,0) ? l4_g_page+=1;
      sprintf(#l4_info,"%d / %d    |    Last MIDI region %d    |    Triggers %d",l4_g_page+1,l4_g_pages,atomic_get(l4_meter_variation),atomic_get(l4_meter_sequence));master_text(193,610,610,#l4_info,12,3);
