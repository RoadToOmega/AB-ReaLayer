desc:Variation Sampler - Milestone 9 (0.9.0)
author:Original implementation for Multi Layer Sampler
version:0.9.0
tags:instrument sampler
// Generated by src/build.py. Four isolated layers, two 96 MiB PCM banks each.
options:maxmem=100958208 prealloc=* gfx_idle no_meter
in_pin:none
out_pin:Left
out_pin:Right
slider1:-4<-60,6,0.1>-Master output (dB)
slider2:0<0,16,1>-MIDI channel (0 = all)
slider3:-1<-1,127,1>-Trigger note (-1 = all)
slider4:2<0.1,10,0.1>-Edge fade (ms)
slider5:0<0,1,1{Transport start and manual,Manual only}>-Sequence reset policy
slider6:-1<-1,119,1>-Sequence reset MIDI CC (-1 = off)
slider7:0<-60,6,0.1>-Layer 1: Volume (dB)
slider8:0<-1,1,0.01>-Layer 1: Pan / stereo balance
slider9:0<-24,24,0.01>-Layer 1: Pitch (semitones)
slider10:1<0,1,1{Muted,Enabled}>-Layer 1: Enable
slider11:0<0,1,1{Off,Solo}>-Layer 1: Solo
slider12:0<0,4,1{Random no repeat,Shuffle bag,Round robin,Random,Fixed}>-Layer 1: Selection
slider13:12345<1,16777215,1>-Layer 1: Seed
slider14:0<0,1,1{Variations,Whole WAV}>-Layer 1: Playback
slider15:1<1,256,1>-Layer 1: Audition / fixed region
slider16:0<0,12,0.01>-Layer 1: Random pitch (+/- st)
slider17:0<0,12,0.1>-Layer 1: Random gain (+/- dB)
slider18:0<0,1,0.01>-Layer 1: Random pan (+/-)
slider19:0<-60,6,0.1>-Layer 2: Volume (dB)
slider20:0<-1,1,0.01>-Layer 2: Pan / stereo balance
slider21:0<-24,24,0.01>-Layer 2: Pitch (semitones)
slider22:1<0,1,1{Muted,Enabled}>-Layer 2: Enable
slider23:0<0,1,1{Off,Solo}>-Layer 2: Solo
slider24:0<0,4,1{Random no repeat,Shuffle bag,Round robin,Random,Fixed}>-Layer 2: Selection
slider25:117074<1,16777215,1>-Layer 2: Seed
slider26:0<0,1,1{Variations,Whole WAV}>-Layer 2: Playback
slider27:1<1,256,1>-Layer 2: Audition / fixed region
slider28:0<0,12,0.01>-Layer 2: Random pitch (+/- st)
slider29:0<0,12,0.1>-Layer 2: Random gain (+/- dB)
slider30:0<0,1,0.01>-Layer 2: Random pan (+/-)
slider31:0<-60,6,0.1>-Layer 3: Volume (dB)
slider32:0<-1,1,0.01>-Layer 3: Pan / stereo balance
slider33:0<-24,24,0.01>-Layer 3: Pitch (semitones)
slider34:1<0,1,1{Muted,Enabled}>-Layer 3: Enable
slider35:0<0,1,1{Off,Solo}>-Layer 3: Solo
slider36:0<0,4,1{Random no repeat,Shuffle bag,Round robin,Random,Fixed}>-Layer 3: Selection
slider37:221803<1,16777215,1>-Layer 3: Seed
slider38:0<0,1,1{Variations,Whole WAV}>-Layer 3: Playback
slider39:1<1,256,1>-Layer 3: Audition / fixed region
slider40:0<0,12,0.01>-Layer 3: Random pitch (+/- st)
slider41:0<0,12,0.1>-Layer 3: Random gain (+/- dB)
slider42:0<0,1,0.01>-Layer 3: Random pan (+/-)
slider43:0<-60,6,0.1>-Layer 4: Volume (dB)
slider44:0<-1,1,0.01>-Layer 4: Pan / stereo balance
slider45:0<-24,24,0.01>-Layer 4: Pitch (semitones)
slider46:1<0,1,1{Muted,Enabled}>-Layer 4: Enable
slider47:0<0,1,1{Off,Solo}>-Layer 4: Solo
slider48:0<0,4,1{Random no repeat,Shuffle bag,Round robin,Random,Fixed}>-Layer 4: Selection
slider49:326532<1,16777215,1>-Layer 4: Seed
slider50:0<0,1,1{Variations,Whole WAV}>-Layer 4: Playback
slider51:1<1,256,1>-Layer 4: Audition / fixed region
slider52:0<0,12,0.01>-Layer 4: Random pitch (+/- st)
slider53:0<0,12,0.1>-Layer 4: Random gain (+/- dB)
