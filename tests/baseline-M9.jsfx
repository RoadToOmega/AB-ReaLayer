    l2_g_error==-8 ? #l2_status="Invalid saved regions. Drop WAV to recover." :
    l2_g_error==-9 ? #l2_status="Insufficient JSFX memory. This build requires about 770 MiB." :
    l2_g_overflow ? #l2_status="More than 256 regions. Increase quiet gap or minimum duration." :
    l2_edit_active ? #l2_status="Editing draft. MIDI plays the applied regions until Apply edits." :
    l2_g_preview ? #l2_status="Detection preview ready. Apply to use these boundaries." :
    l2_gui_loader.l2_status==2 && l2_g_token!=l2_gui_loader.l2_request*4+l2_gui_loader.l2_bank+1 ? #l2_status="Prepared: waiting for audio to adopt the new bank." :
    l2_g_dirty && l2_g_token>0 ? #l2_status="Detection settings changed. Reanalyse to preview new boundaries." :
    strlen(#l2_ui_message)>0 ? strcpy(#l2_status,#l2_ui_message) : #l2_status="Click a region tile to audition. MIDI uses the chosen selection mode.";
  );
