    limiter_release=exp(-1/(.08*srate));limiter_toggle_step=1/max(1,.005*srate);
    limiter_guard_count=0;limiter_block_gr=0;ext_gr_meter=0;
  );
  pdc_delay=limiter_delay;pdc_bot_ch=0;pdc_top_ch=2;
  atomic_set(limiter_meter,limiter_block_gr);ext_gr_meter=-limiter_block_gr;limiter_block_gr=0;
);
function limiter_process() local(p,peak,tail,required,left,right,effective,actual,release_coef) (
  // Delay always runs, including bypass, so toggle automation cannot change PDC.
  p=limiter_base+limiter_write*2;left=p[0];right=p[1];p[0]=spl0;p[1]=spl1;
  limiter_write+=1;limiter_write>=limiter_delay ? limiter_write=0;
  peak=max(abs(spl0),abs(spl1));
  while(limiter_count>0 && limiter_queue_time[limiter_head]<limiter_time-limiter_delay) (
    limiter_head=(limiter_head+1)%4096;limiter_count-=1;
  );
  while(limiter_count>0 && limiter_queue_value[(limiter_head+limiter_count-1)%4096]<=peak) (limiter_count-=1;);
  tail=(limiter_head+limiter_count)%4096;limiter_queue_value[tail]=peak;limiter_queue_time[tail]=limiter_time;limiter_count+=1;
  required=min(1,limiter_ceiling/max(.000000000001,limiter_queue_value[limiter_head]));
  // A newly observed peak stays in the window until its delayed sample exits.
  // Linear attack can traverse the entire gain range within the lookahead.
